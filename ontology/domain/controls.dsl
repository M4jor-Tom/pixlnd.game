r_c_unselected_boundaries = element "c-unselected-boundaries" "SectionNote" {
    tags "SectionNote,Overview"
    properties {
        "id" "c-unselected-boundaries"
        "kind" "SectionNote"
        "order" "107"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "controls.md"
        "source.start" "107"
        "source.end" "120"
        "title" "Unselected boundaries"
        "heading.level" "2"
        "heading.slug" "unselected-boundaries"
        "section" "Overview"
        "note.001.kind" "paragraph"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "This is a documentation contract, not runtime authorization or a new engine schema. Profiles"
        "note.001.line.002.state" "text"
        "note.001.line.002.text" "must expose the same distinct meanings without inventing layouts. Android's"
        "note.001.line.003.state" "text"
        "note.001.line.003.text" "[native tool stack](../decisions/android-native-touch-controls.md) and"
        "note.001.line.004.state" "text"
        "note.001.line.004.text" "[touch-profile policy (locator=android)](controller-profiles.dsl) have a first-slice runtime, owner hardware-tested; detailed coverage and render cost are unrecorded."
        "note.001.line.005.state" "text"
        "note.001.line.005.text" "Broader catalog implementation remains deferred."
        "note.001.line.006.state" "text"
        "note.001.line.006.text" "Gamepad remains unselected; Android's first-slice device/customization deferrals are"
        "note.001.line.007.state" "text"
        "note.001.line.007.text" "[profile-owned (locator=android-device-scope)](controller-profiles.dsl). Deferred traversal/bench/map UI"
        "note.001.line.008.state" "text"
        "note.001.line.008.text" "shapes and other profiles' unresolved shared-request arbitration remain bounded above. Wall-flip/detach lifecycle, map travel, sleep-consent UI and source-only class-utility/chord activation have"
        "note.001.line.009.state" "text"
        "note.001.line.009.text" "no newly selected controls; their existing gameplay rules remain authoritative. No historical"
        "note.001.line.010.state" "text"
        "note.001.line.010.text" "binding is a fallback for an unspecified present mapping. Pet unsummoning and player item-drop /"
        "note.001.line.011.state" "text"
        "note.001.line.011.text" "trading activation are not selected by the current catalog; old source gestures confer no"
        "note.001.line.012.state" "text"
        "note.001.line.012.text" "activation permission."
        "note.001.source.file" "controls.md"
        "note.001.source.start" "109"
        "note.001.source.end" "120"
    }
}
