// Authoritative domain records. source.* coordinates refer only to baseline 175e0c59b6a05ead62d29bd851085cd5a3818378.
r_c_controls = element "c-controls" "SectionNote" {
    tags "SectionNote,Overview"
    properties {
        "id" "c-controls"
        "kind" "SectionNote"
        "order" "1"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "controls.md"
        "source.start" "1"
        "source.end" "8"
        "title" "Controls"
        "heading.level" "1"
        "heading.slug" "controls"
        "section" "Overview"
        "note.001.kind" "paragraph"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "The single present-time catalog of **player intentions**, independent of any device."
        "note.001.line.002.state" "text"
        "note.001.line.002.text" "[Controller profiles](controller-profiles.dsl) refer to these stable action IDs; they alone"
        "note.001.line.003.state" "text"
        "note.001.line.003.text" "own physical bindings, aliases and shared-input phases. An action is not an ability, a key,"
        "note.001.line.004.state" "text"
        "note.001.line.004.text" "an engine InputMap name or proof of implementation. Effects, costs, eligibility and balance"
        "note.001.line.005.state" "text"
        "note.001.line.005.text" "remain in the linked gameplay definitions; later owner approvals override stale instance prose."
        "note.001.source.file" "controls.md"
        "note.001.source.start" "3"
        "note.001.source.end" "7"
    }
}

r_c_contract = element "c-contract" "SectionNote" {
    tags "SectionNote,Overview"
    properties {
        "id" "c-contract"
        "kind" "SectionNote"
        "order" "9"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "controls.md"
        "source.start" "9"
        "source.end" "26"
        "title" "Contract"
        "heading.level" "2"
        "heading.slug" "contract"
        "section" "Overview"
        "note.001.kind" "list"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "- Each row has a stable ID/anchor, meaning, value/lifecycle and context. Distinct intentions"
        "note.001.line.002.state" "text"
        "note.001.line.002.text" "  stay distinct even when a profile currently drives them from the same input."
        "note.001.line.003.state" "text"
        "note.001.line.003.text" "- **Trigger** means one request on activation, not automatic repetition. **Held** means"
        "note.001.line.004.state" "text"
        "note.001.line.004.text" "  active/inactive with start/end. **Direction** and **adjustment** describe semantic values,"
        "note.001.line.005.state" "text"
        "note.001.line.005.text" "  not a device axis, sensitivity, deadzone or analog speed-scaling policy."
        "note.001.line.006.state" "text"
        "note.001.line.006.text" "- Special-attack release is an intentional completion for charged classes, not a universal"
        "note.001.line.007.state" "text"
        "note.001.line.007.text" "  cancellation rule. Device interruption, focus loss, interrupted holds, UI consumption and"
        "note.001.line.008.state" "text"
        "note.001.line.008.text" "  conflicting simultaneous requests need explicit adapter treatment; this catalog does not"
        "note.001.line.009.state" "text"
        "note.001.line.009.text" "  choose their gameplay outcome or arbitration priority. Profiles own that policy; see the"
        "note.001.line.010.state" "text"
        "note.001.line.010.text" "  selected [Android interruption (locator=android-interruption)](controller-profiles.dsl) and"
        "note.001.line.011.state" "text"
        "note.001.line.011.text" "  [request-order rules (locator=android-request-order)](controller-profiles.dsl)."
        "note.001.line.012.state" "text"
        "note.001.line.012.text" "- Context limits meaning; it does not add eligibility or new input availability. In particular,"
        "note.001.line.013.state" "text"
        "note.001.line.013.text" "  inventory/skills/shop retain their [live-time and input restrictions (locator=hud-element)](3_Classes.dsl)."
        "note.001.line.014.state" "text"
        "note.001.line.014.text" "  Time/input behavior for other menus is not selected. Enemy [current-target (locator=threat-and-current-target-hybrid)](4_Relations.dsl)"
        "note.001.line.015.state" "text"
        "note.001.line.015.text" "  is not a player lock-on control; no new targeting is introduced here."
        "note.001.source.file" "controls.md"
        "note.001.source.start" "11"
        "note.001.source.end" "25"
    }
}

