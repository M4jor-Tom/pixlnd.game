        "source.file" "5_Constraints.md"
        "source.start" "209"
        "source.end" "209"
        "rule.state" "text"
        "rule.text" "hybrid combat hit-derived burning applications coexist independently, without replacing or refreshing earlier burns; each lasts 4 s with eight ticks at 0.5, 1, …, 4 s after application, at the existing 10% of triggering-hit coefficient; preserve Resistance, dodge/status protections and aggro rules; environmental hazards and additional DOT buff timing are outside scope (§3.3 status-effect)"
        "layer.state" "text"
        "layer.text" "load-time (selected design inputs) + runtime"
    }
}

r_c_combat_poison_applications = element "c-combat-poison-applications" "Constraint" {
