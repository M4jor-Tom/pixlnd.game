        "source.start" "201"
        "source.end" "201"
        "rule.state" "text"
        "rule.text" "roll = ((attributes<<16)+modifier) mod 21 ∈ 0..20; normalized roll = roll/20, not rarity; hybrid gear HP is fixed under §3.4 item and independent of this roll, with no change to other stat rules"
        "layer.state" "text"
        "layer.text" "generator (hybrid HP deferred)"
    }
}

