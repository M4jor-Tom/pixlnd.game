        "source.file" "5_Constraints.md"
        "source.start" "192"
        "source.end" "192"
        "rule.state" "text"
        "rule.text" "A / hybrid: item.level ≤ power(player.level) for full strength; formula learning retains its sufficient-power requirement. Hybrid books record recipes immediately, but above-power recipes remain known and visibly locked against crafting until their requirement is reached; duplicate acquisition never removes the lock (§3.5 power-gate)"
        "layer.state" "text"
        "layer.text" "runtime (recipe enforcement deferred)"
    }
}

r_c_book_recipe_persistence = element "c-book-recipe-persistence" "Constraint" {
