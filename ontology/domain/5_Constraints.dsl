r_5_validation_contract_item_9_owner_approved_2026_09_17 = element "5-validation-contract-item-9-owner-approved-2026-09-17" "SectionNote" {
    tags "SectionNote,Overview"
    properties {
        "id" "5-validation-contract-item-9-owner-approved-2026-09-17"
        "kind" "SectionNote"
        "order" "3"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "5_Constraints.md"
        "source.start" "3"
        "source.end" "44"
        "title" "Validation contract (item 9, owner approved 2026-09-17)"
        "heading.level" "3"
        "heading.slug" "validation-contract-item-9-owner-approved-2026-09-17"
        "section" "Overview"
        "note.001.kind" "paragraph"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "This is the required validation behavior, **not a claim that the current checker implements it**."
        "note.001.line.002.state" "text"
        "note.001.line.002.text" "Approval covers ontology documentation only; loader, validator, generator and gameplay changes"
        "note.001.line.003.state" "text"
        "note.001.line.003.text" "remain separately authorized work (`docs/ROADMAP/todo_implement.md`)."
        "note.001.source.file" "5_Constraints.md"
        "note.001.source.start" "5"
        "note.001.source.end" "7"
        "note.002.kind" "list"
        "note.002.line.001.state" "text"
        "note.002.line.001.text" "- **Required data:** tables and config blocks needed by active, approved hybrid systems must"
        "note.002.line.002.state" "text"
        "note.002.line.002.text" "  be present and have the documented root/row shapes. Missing data must fail validation, not"
        "note.002.line.003.state" "text"
        "note.002.line.003.text" "  silently skip its checks; this includes the race catalog and the whole `design.movesets`"
        "note.002.line.004.state" "text"
        "note.002.line.004.text" "  block. Derive required paths from the approved domain and dependencies, not from whichever"
        "note.002.line.005.state" "text"
        "note.002.line.005.text" "  files happen to load. Reference/roadmap coverage does not by itself enable a hybrid system"
        "note.002.line.006.state" "text"
        "note.002.line.006.text" "  or require its runtime implementation."
        "note.002.line.007.state" "text"
        "note.002.line.007.text" "- **Existing rules:** validate class/spec references in both directions, two specs per class"
        "note.002.line.008.state" "text"
        "note.002.line.008.text" "  with distinct indices 0/1 and index 0 first, shared skill-column roots and weapon upgrade"
        "note.002.line.009.state" "text"
        "note.002.line.009.text" "  capacities according to their approved definitions. Preserve the approved Assassin single-node"
        "note.002.line.010.state" "text"
        "note.002.line.010.text" "  exception (§3.5) and the approved two-handed wand (§3.3); do not settle open choices through"
        "note.002.line.011.state" "text"
        "note.002.line.011.text" "  a validator default."
        "note.002.line.012.state" "text"
        "note.002.line.012.text" "- **Provenance:** versioned content must resolve at least one source-version tag, explicitly"
        "note.002.line.013.state" "text"
        "note.002.line.013.text" "  or through an inheritance rule documented for that family and its source. Missing tags"
        "note.002.line.014.state" "text"
        "note.002.line.014.text" "  are not permission to assume A/S, infer provenance from a numeric ID, or enable content."
        "note.002.line.015.state" "text"
        "note.002.line.015.text" "  Item 9 alone established no per-family inheritance rules; item 4 below records the bounded"
        "note.002.line.016.state" "text"
        "note.002.line.016.text" "  mappings now approved. Unscoped histories remain research. Metadata/config containers are"
        "note.002.line.017.state" "text"
        "note.002.line.017.text" "  not automatically content instances."
        "note.002.line.018.state" "text"
        "note.002.line.018.text" "  Taxonomy/style config, pet-food evidence and qualified reference annotations follow the"
        "note.002.line.019.state" "text"
        "note.002.line.019.text" "  Validation-contract mapping below."
        "note.002.line.020.state" "text"
        "note.002.line.020.text" "- **Definitions versus generated instances:** load-time checks validate available definitions"
        "note.002.line.021.state" "text"
        "note.002.line.021.text" "  and generator configuration, not nonexistent generated objects. For artifacts, check the"
        "note.002.line.022.state" "text"
        "note.002.line.022.text" "  definition's seven approved traversal stat kinds and approved bonus configuration at load time;"
        "note.002.line.023.state" "text"
        "note.002.line.023.text" "  generator/runtime checks separately verify each generated artifact has exactly one of"
        "note.002.line.024.state" "text"
        "note.002.line.024.text" "  those traversal bonuses plus attack and max HP. The approved accumulation curve, counts and"
        "note.002.line.025.state" "text"
        "note.002.line.025.text" "  recalculation are in §3.4 `artifact`; direct data correction and enforcement remain deferred."
        "note.002.line.026.state" "text"
        "note.002.line.026.text" "  Passing definition checks is not evidence that generated rewards or runtime behavior work."
        "note.002.line.027.state" "text"
        "note.002.line.027.text" "- **Result:** validation succeeds only when the accumulated load/validation error collection"
        "note.002.line.028.state" "text"
        "note.002.line.028.text" "  is empty. Earlier load errors remain failures even if a validation pass adds no new errors."
        "note.002.line.029.state" "text"
        "note.002.line.029.text" "  Malformed data must produce an error rather than be silently discarded or treated as valid."
        "note.002.source.file" "5_Constraints.md"
        "note.002.source.start" "9"
        "note.002.source.end" "37"
        "note.003.kind" "paragraph"
        "note.003.line.001.state" "text"
        "note.003.line.001.text" "The required paths, permitted source inheritance and check boundaries are mapped below."
        "note.003.line.002.state" "text"
        "note.003.line.002.text" "Resolve remaining source attribution from evidence before its affected checks; ask the owner"
        "note.003.line.003.state" "text"
        "note.003.line.003.text" "only where approved rules leave a genuine choice, never fill gaps by guessing."
        "note.003.line.004.state" "text"
        "note.003.line.004.text" "Negative regressions must cover missing whole inputs as well as invalid entries. No balance,"
        "note.003.line.005.state" "text"
        "note.003.line.005.text" "content selection or live data changes are authorized by this contract."
        "note.003.source.file" "5_Constraints.md"
        "note.003.source.start" "39"
        "note.003.source.end" "43"
    }
}

r_5_validation_contract_mapping_owner_approved_2026_09_28 = element "5-validation-contract-mapping-owner-approved-2026-09-28" "SectionNote" {
    tags "SectionNote,Overview"
    properties {
        "id" "5-validation-contract-mapping-owner-approved-2026-09-28"
        "kind" "SectionNote"
        "order" "45"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "5_Constraints.md"
        "source.start" "45"
        "source.end" "68"
        "title" "Validation-contract mapping (owner approved, 2026-09-28)"
        "heading.level" "3"
        "heading.slug" "validation-contract-mapping-owner-approved-2026-09-28"
        "section" "Overview"
        "note.001.kind" "paragraph"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "**Item 1 — Hybrid taxonomy/configuration:** the 12 top-level families in"
        "note.001.line.002.state" "text"
        "note.001.line.002.text" "`creature-families.json` (`beetles`, `runners`, `slimes`, `alpacas`, `dogs`, `cats`, `golems`,"
        "note.001.line.003.state" "text"
        "note.001.line.003.text" "`trolls`, `skeletons`, `sprouts`, `guardians`, `fish`) and `buildings.json#settlement-styles`"
        "note.001.line.004.state" "text"
        "note.001.line.004.text" "are source-independent hybrid taxonomy/style configuration. Validate their stable IDs, shapes"
        "note.001.line.005.state" "text"
        "note.001.line.005.text" "and references; do not manufacture A/S ancestry or derive it from member-version unions."
        "note.001.line.006.state" "text"
        "note.001.line.006.text" "This is not a whole-file exemption: separately sourced historical facts, including embedded"
        "note.001.line.007.state" "text"
        "note.001.line.007.text" "trait descriptions, retain their provenance; nested spawn rosters and versioned buildings/districts"
        "note.001.line.008.state" "text"
        "note.001.line.008.text" "are outside this classification. Existing family assignments, creature behavior, encounters and"
        "note.001.line.009.state" "text"
        "note.001.line.009.text" "settlement styles stand; no species-trait inheritance or numerical family modifier is introduced."
        "note.001.source.file" "5_Constraints.md"
        "note.001.source.start" "47"
        "note.001.source.end" "55"
        "note.002.kind" "paragraph"
        "note.002.line.001.state" "text"
        "note.002.line.001.text" "**Item 2 — Individual pet-food provenance:** evidence and unresolved claims follow §3.4"
        "note.002.line.002.state" "text"
        "note.002.line.002.text" "`pet-food`, independently of approved taming pairings and numeric source identity."
        "note.002.source.file" "5_Constraints.md"
        "note.002.source.start" "57"
        "note.002.source.end" "58"
        "note.003.kind" "paragraph"
        "note.003.line.001.state" "text"
        "note.003.line.001.text" "**Item 3 — Qualified source annotations:** retain `S?` and `A?` as uncertainty-qualified"
        "note.003.line.002.state" "text"
        "note.003.line.002.text" "source annotations for reference records, not confirmed S/A history. These annotations do not"
        "note.003.line.003.state" "text"
        "note.003.line.003.text" "independently establish hybrid availability; explicit hybrid decisions still govern it (§1)."
        "note.003.line.004.state" "text"
        "note.003.line.004.text" "An uncertain Swamp Lands reference remains useful for research without deciding its identity or"
        "note.003.line.005.state" "text"
        "note.003.line.005.text" "adding a distinct shipping biome. Do not delete or reject a reference merely for its qualified"
        "note.003.line.006.state" "text"
        "note.003.line.006.text" "tag, or silently promote it to confirmed history. This chooses no runtime schema/type or parser"
        "note.003.line.007.state" "text"
        "note.003.line.007.text" "behavior: the current parser strips `?`; preserving the qualification in model/loader/validator"
        "note.003.line.008.state" "text"
        "note.003.line.008.text" "handling remains deferred and unauthorized."
        "note.003.source.file" "5_Constraints.md"
        "note.003.source.start" "60"
        "note.003.source.end" "67"
    }
}

r_5_item_4__required_inputs_source_scopes_and_check_boundaries = element "5-item-4--required-inputs-source-scopes-and-check-boundaries" "SectionNote" {
    tags "SectionNote,Overview"
    properties {
        "id" "5-item-4--required-inputs-source-scopes-and-check-boundaries"
        "kind" "SectionNote"
        "order" "69"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "5_Constraints.md"
        "source.start" "69"
        "source.end" "172"
        "title" "Item 4 — Required inputs, source scopes and check boundaries"
        "heading.level" "4"
        "heading.slug" "item-4--required-inputs-source-scopes-and-check-boundaries"
        "section" "Overview"
        "note.001.kind" "paragraph"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "Owner approved 2026-09-28, with the undeployed-game clarification in §0. This maps existing"
        "note.001.line.002.state" "text"
        "note.001.line.002.text" "rules, not new content, balance or a serialization schema. Required means dependencies of the"
        "note.001.line.003.state" "text"
        "note.001.line.003.text" "**approved hybrid**, including unimplemented systems, not merely today's consumers. Within a"
        "note.001.line.004.state" "text"
        "note.001.line.004.text" "mixed file, historical A/S alternatives, X/cut and Omega-only rows remain reference; requiring"
        "note.001.line.005.state" "text"
        "note.001.line.005.text" "its active definitions does not activate every row or require generating objects at load time."
        "note.001.source.file" "5_Constraints.md"
        "note.001.source.start" "71"
        "note.001.source.end" "75"
        "note.002.kind" "paragraph"
        "note.002.line.001.state" "text"
        "note.002.line.001.text" "**Required paths and shapes.** Paths below are relative to `ontology/instances/`; each file"
        "note.002.line.002.state" "text"
        "note.002.line.002.text" "root is an object. Braces enumerate exact sibling paths, not arbitrary keys. A catalog is an"
        "note.002.line.003.state" "text"
        "note.002.line.003.text" "ID→row-object map unless noted. Metadata (`$schema`, `_doc`, source notes, examples and negative"
        "note.002.line.004.state" "text"
        "note.002.line.004.text" "research) is not a content row; neither silently discard malformed catalog rows nor flatten"
        "note.002.line.005.state" "text"
        "note.002.line.005.text" "legitimate arrays/scalars/config into invented instances. The §3 definitions and constraint"
        "note.002.line.006.state" "text"
        "note.002.line.006.text" "catalog govern row fields and numeric/reference rules; the inventory locates their inputs."
        "note.002.source.file" "5_Constraints.md"
        "note.002.source.start" "77"
        "note.002.source.end" "82"
        "note.003.kind" "table"
        "note.003.column.001.text" "dependency"
        "note.003.column.002.text" "required definition/config paths and heterogeneous shapes"
        "note.003.row.001.source.file" "5_Constraints.md"
        "note.003.row.001.source.start" "86"
        "note.003.row.001.source.end" "86"
        "note.003.row.001.cell.001.state" "text"
        "note.003.row.001.cell.001.text" "Identity and skills (§3.2/§3.5)"
        "note.003.row.001.cell.002.state" "text"
        "note.003.row.001.cell.002.text" "`races.json`, `classes.json`, `specializations.json`, `abilities.json` catalogs; `abilities.json#<id>.alpha-tree` is a per-ability object, not a root table."
        "note.003.row.002.source.file" "5_Constraints.md"
        "note.003.row.002.source.start" "87"
        "note.003.row.002.source.end" "87"
        "note.003.row.002.cell.001.state" "text"
        "note.003.row.002.cell.001.text" "Combat and item types (§3.3/§3.4)"
        "note.003.row.002.cell.002.state" "text"
        "note.003.row.002.cell.002.text" "`weapon-types.json`, `materials.json`, `item-types.json`, `rarities.json`, `status-effects.json` catalogs. Rarity comparison maps `mob-strength-tiers-s` / `alpha-relative-colors` are separate reference config; `status-effects.json#ability-buffs` is a definition-reference object and `#not-found` a negative-research array, not effects to instantiate."
        "note.003.row.003.source.file" "5_Constraints.md"
        "note.003.row.003.source.start" "88"
        "note.003.row.003.source.end" "88"
        "note.003.row.003.cell.001.state" "text"
        "note.003.row.003.cell.001.text" "Stats and slots (§3.3–5)"
        "note.003.row.003.cell.002.state" "text"
        "note.003.row.003.cell.002.text" "`stats.json#{resources,stats}` catalogs and `#{alpha-item-stat-formulas,alpha-character-formulas}` mixed formula objects (strings, numbers, tables); `equipment-slots.json#slots` an array of rows with `id`/index, `#extra` an object of separate quick-use/taming descriptions, `#rules` a string array. Current slot acceptance text must conform to §3.4, not redefine it."
        "note.003.row.004.source.file" "5_Constraints.md"
        "note.003.row.004.source.start" "89"
        "note.003.row.004.source.end" "89"
        "note.003.row.004.cell.001.state" "text"
        "note.003.row.004.cell.001.text" "Creatures and pets (§3.2/§3.4)"
        "note.003.row.004.cell.002.state" "text"
        "note.003.row.004.cell.002.text" "`creatures.json` catalog; the 12 `creature-families.json` config objects listed in item 1; `#landscape-rosters` maps to creature-ID arrays; `#forest-dungeon-rosters` maps to objects with `members` arrays and `boss` strings, including race/family tokens, not uniformly creature IDs. `pet-food.json#foods` catalog; `#rules` / `#shop-set` arrays; `#cut` a separate reference catalog."
        "note.003.row.005.source.file" "5_Constraints.md"
        "note.003.row.005.source.start" "90"
        "note.003.row.005.source.end" "90"
        "note.003.row.005.cell.001.state" "text"
        "note.003.row.005.cell.001.text" "World and encounters (§3.1/§3.6)"
        "note.003.row.005.cell.002.state" "text"
        "note.003.row.005.cell.002.text" "`landscapes.json`, `terrain-features.json`, `flora.json`, `deposits.json`, `dungeon-types.json`, `poi-types.json`, `factions.json` catalogs (realm-name examples are not factions); `landscapes.json#<id>.gen` objects for generated hybrid landscapes. `mission-types.json#{alpha,steam}` nested catalogs, with `_shared` config and `steam.region-completion-order` guide array distinct from mission rows."
        "note.003.row.006.source.file" "5_Constraints.md"
        "note.003.row.006.source.start" "91"
        "note.003.row.006.source.end" "91"
        "note.003.row.006.cell.001.state" "text"
        "note.003.row.006.cell.001.text" "Blocks and structures (§3.1)"
        "note.003.row.006.cell.002.state" "text"
        "note.003.row.006.cell.002.text" "`block-types.json#alpha` numeric-key→row objects plus `flags`, `#steam` numeric-key→strings plus `note`, `#{scale,cub-format}` config objects; `static-entities.json#by-id` numeric-key→name strings, `#behaviour` a mixed description map, `#s-additions` string array, `#candles` config object. Numeric table presence is not content availability."
        "note.003.row.007.source.file" "5_Constraints.md"
        "note.003.row.007.source.start" "92"
        "note.003.row.007.source.end" "92"
        "note.003.row.007.cell.001.state" "text"
        "note.003.row.007.cell.001.text" "Crafting and traversal (§3.4/§3.5)"
        "note.003.row.007.cell.002.state" "text"
        "note.003.row.007.cell.002.text" "`consumables.json`, `ingredients.json`, `crafting-stations.json`, `key-items.json` catalogs with separate summary/config objects (`consumables#rules`, `key-items#counts-per-land-s` and cut `#special-accessories-x`). `recipes.json#{gear-armor-quantities,gear-weapons,refining,recipe-sources,customization}` mixed rule/recipe objects; `#{cooking,alchemy}` objects referring to consumables; `#crafting-tabs-a` string array. `key-items.json#artifact.stat-kinds` is the seven-kind definition array, not generated rewards."
        "note.003.row.008.source.file" "5_Constraints.md"
        "note.003.row.008.source.start" "93"
        "note.003.row.008.source.end" "93"
        "note.003.row.008.cell.001.state" "text"
        "note.003.row.008.cell.001.text" "Settlements and economy (§3.1/§3.4)"
        "note.003.row.008.cell.002.state" "text"
        "note.003.row.008.cell.002.text" "`buildings.json#{districts,buildings}` catalogs, `#{settlement-styles,population,map-visibility}` config objects; `npc-roles.json` catalog (dialogue corpus separate); `economy.json#{currency,incomes,prices,shops,rules,loot}` mixed source/config objects. Approved hybrid services, prices and resets govern, not historical alternatives."
        "note.003.row.009.source.file" "5_Constraints.md"
        "note.003.row.009.source.start" "94"
        "note.003.row.009.source.end" "94"
        "note.003.row.009.cell.001.state" "text"
        "note.003.row.009.cell.001.text" "Names (gen-name)"
        "note.003.row.009.cell.002.state" "text"
        "note.003.row.009.cell.002.text" "`affixes.json#{common,uncommon,rare,epic,legendary,name-forms}` string arrays; examples are reference and `#plus-suffix` is an excluded S mechanic, not hybrid naming."
        "note.003.row.010.source.file" "5_Constraints.md"
        "note.003.row.010.source.start" "95"
        "note.003.row.010.source.end" "95"
        "note.003.row.010.cell.001.state" "text"
        "note.003.row.010.cell.001.text" "Rules, controls and presentation (§3.7)"
        "note.003.row.010.cell.002.state" "text"
        "note.003.row.010.cell.002.text" "`rulesets.json#ruleset-hybrid` object with `flags` object and default boolean; other rulesets reference only. [controls](controls.dsl) canonical action catalog and [controller profiles](controller-profiles.dsl); `controller-profiles.json#android` required selected first-slice constants (0.15 deadzone ratio, 48 dp minimum target, 180 degrees per safe width) and distinct canonical action array; `keybinds.json#hybrid` retained keyboard-adapter binding object (not the action registry); `ui.json#{hud,screens,options,camera}` grouped objects; `audio.json#sfx-alpha-ids` string array (includes descriptive entries, not all asset IDs). `slash-commands.json` command-key→row catalog with separate `cuwo-server-commands` array / `chat-rules` object; only approved commands, never `/pvp`. Historical audio backend/track records are not runtime asset requirements."
        "note.003.source.file" "5_Constraints.md"
        "note.003.source.start" "84"
        "note.003.source.end" "95"
        "note.004.kind" "paragraph"
        "note.004.line.001.state" "text"
        "note.004.line.001.text" "`versions.json#{timeline,alpha-to-steam-delta,reception}` (array/object/object) is history"
        "note.004.line.002.state" "text"
        "note.004.line.002.text" "coverage, not an active gameplay dependency merely because the directory loader visits it."
        "note.004.line.003.state" "text"
        "note.004.line.003.text" "Reference data still needs structural validity and qualified attribution; no whole-file exemption"
        "note.004.line.004.state" "text"
        "note.004.line.004.text" "or uniform row-shape assumption follows from the active/reference distinction."
        "note.004.source.file" "5_Constraints.md"
        "note.004.source.start" "97"
        "note.004.source.end" "100"
        "note.005.kind" "paragraph"
        "note.005.line.001.state" "text"
        "note.005.line.001.text" "`generators.json#design` is required as an object. Its required children are grouped below;"
        "note.005.line.002.state" "text"
        "note.005.line.002.text" "existing config constraints specify dependent fields. Current obsolete values do **not** satisfy"
        "note.005.line.003.state" "text"
        "note.005.line.003.text" "later approvals. In particular, require the approved artifact logarithm directly, not decay/floor"
        "note.005.line.004.state" "text"
        "note.005.line.004.text" "as an accepted alternate format. This chooses no new JSON keys for that rule."
        "note.005.source.file" "5_Constraints.md"
        "note.005.source.start" "102"
        "note.005.source.end" "105"
        "note.006.kind" "table"
        "note.006.column.001.text" "dependency"
        "note.006.column.002.text" "exact `design` children and nested shapes"
        "note.006.row.001.source.file" "5_Constraints.md"
        "note.006.row.001.source.start" "109"
        "note.006.row.001.source.end" "109"
        "note.006.row.001.cell.001.state" "text"
        "note.006.row.001.cell.001.text" "World/spawns"
        "note.006.row.001.cell.002.state" "text"
        "note.006.row.001.cell.002.text" "`{enemy-level,enemy-hp,terrain,climate,names,spawns}` objects; `terrain.{height,heightfield}` and `spawns.ai` objects, `climate.rules` array of `[landscape-id, expression-string]`, `names.syllables` string array / `names.land-suffix` map of string arrays."
        "note.006.row.002.source.file" "5_Constraints.md"
        "note.006.row.002.source.start" "110"
        "note.006.row.002.source.end" "110"
        "note.006.row.002.cell.001.state" "text"
        "note.006.row.002.cell.001.text" "Skills/combat"
        "note.006.row.002.cell.002.state" "text"
        "note.006.row.002.cell.002.text" "`{skill-point,abilities,resources,special-attack,status-effects,progression,crit,movement,camera,combat,defence,movesets}` objects; `abilities.runtimes` / `movesets.kinds` arrays, ability/moveset entries objects (including documented aliases); `resources.mp`, `movement.stamina`, `defence.{dodge,block,stealth,enemy-hit}` objects. Whole `movesets`, `default` and required class-weapon entries cannot be skipped when absent."
        "note.006.row.003.source.file" "5_Constraints.md"
        "note.006.row.003.source.start" "111"
        "note.006.row.003.source.end" "111"
        "note.006.row.003.cell.001.state" "text"
        "note.006.row.003.cell.001.text" "Roles/feedback/engine"
        "note.006.row.003.cell.002.state" "text"
        "note.006.row.003.cell.002.text" "`{creature-roles,feel,frame-budget}` objects; `creature-roles.{any-class,melee,ranged,mage,species}` objects and `default` string; `feel.{hit-stop,shake,numbers,impact,trail,level-up,events,sfx}` objects with event/sound references and colour arrays per the catalog."
        "note.006.row.004.source.file" "5_Constraints.md"
        "note.006.row.004.source.start" "112"
        "note.006.row.004.source.end" "112"
        "note.006.row.004.cell.001.state" "text"
        "note.006.row.004.cell.001.text" "Inventory/settlements"
        "note.006.row.004.cell.002.state" "text"
        "note.006.row.004.cell.002.text" "`{prices,stack-cap,loot,starting-inventory,settlement}` objects; `stack-cap.stackable` / `loot.consumable-pool` arrays; `loot.{coins,rarity-weights,gear-kinds,ground}` objects; `settlement.buildings` array, `settlement.npc.roles` / `settlement.style-by-landscape` maps, `settlement.style-colors` map of two-colour arrays, `settlement.{shop,inn,trainer}` objects."
        "note.006.row.005.source.file" "5_Constraints.md"
        "note.006.row.005.source.start" "113"
        "note.006.row.005.source.end" "113"
        "note.006.row.005.cell.001.state" "text"
        "note.006.row.005.cell.001.text" "Other approved systems"
        "note.006.row.005.cell.002.state" "text"
        "note.006.row.005.cell.002.text" "`{artifact,artifacts-per-land,circle-of-power,recipes,pvp}` objects, regardless of incomplete consumers. `{item-stat-curve,block-reward,regeneration}` are **strings**, not object blocks."
        "note.006.source.file" "5_Constraints.md"
        "note.006.source.start" "107"
        "note.006.source.end" "113"
        "note.007.kind" "paragraph"
        "note.007.line.001.state" "text"
        "note.007.line.001.text" "Other `generators.json` inputs for §6 are mixed historical/approved-system objects:"
        "note.007.line.002.state" "text"
        "note.007.line.002.text" "`{world-scales,seed,time,climate,land,terrain,settlement,dungeon,spawns,boss,names,item,realm,npc-appearance,schedule,key-items-s}`;"
        "note.007.line.003.state" "text"
        "note.007.line.003.text" "`loot` and `level-formulas-alpha` are string references. Check approved dependencies within these"
        "note.007.line.004.state" "text"
        "note.007.line.004.text" "containers, not every source-specific alternative as hybrid config. `coarse-map-omega` and"
        "note.007.line.005.state" "text"
        "note.007.line.005.text" "`network-alpha` are reference-only objects; no borders, sleep-fast-forward and client authority"
        "note.007.line.006.state" "text"
        "note.007.line.006.text" "in older source descriptions cannot override the approved bounds, inn skip and server authority."
        "note.007.line.007.state" "text"
        "note.007.line.007.text" "There is no current save-schema file or generated-object catalog to invent as a required input."
        "note.007.source.file" "5_Constraints.md"
        "note.007.source.start" "115"
        "note.007.source.end" "121"
        "note.008.kind" "paragraph"
        "note.008.line.001.state" "text"
        "note.008.line.001.text" "**Permitted source inheritance.** This is a finite mapping of explicit source envelopes, not"
        "note.008.line.002.state" "text"
        "note.008.line.002.text" "an A+S default. Apply only to the stated table facts or subfacts without their own annotation;"
        "note.008.line.003.state" "text"
        "note.008.line.003.text" "retain explicit row-level X, `A?`/`S?`, uncertainty and narrower exceptions. Source-table origin"
        "note.008.line.004.state" "text"
        "note.008.line.004.text" "proves neither shipped source functionality nor hybrid availability. Item 1's taxonomy/style"
        "note.008.line.005.state" "text"
        "note.008.line.005.text" "configuration and owner-authored `design` / hybrid bindings need no invented historical ancestry."
        "note.008.source.file" "5_Constraints.md"
        "note.008.source.start" "123"
        "note.008.source.end" "127"
        "note.009.kind" "table"
        "note.009.column.001.text" "source envelope"
        "note.009.column.002.text" "inherited historical scope and evidence boundary"
        "note.009.row.001.source.file" "5_Constraints.md"
        "note.009.row.001.source.start" "131"
        "note.009.row.001.source.end" "131"
        "note.009.row.001.cell.001.state" "text"
        "note.009.row.001.cell.001.text" "`block-types.json#{alpha,steam}`"
        "note.009.row.001.cell.002.state" "text"
        "note.009.row.001.cell.002.text" "A / S table facts respectively (`research/research_world.md §2.3`); flags/notes remain metadata, not block instances."
        "note.009.row.002.source.file" "5_Constraints.md"
        "note.009.row.002.source.start" "132"
        "note.009.row.002.source.end" "132"
        "note.009.row.002.cell.001.state" "text"
        "note.009.row.002.cell.001.text" "`item-types.json` alpha type/subtype table"
        "note.009.row.002.cell.002.state" "text"
        "note.009.row.002.cell.002.text" "A table origin from `_doc` (cuwo ItemData), corroborated by `research/research_systems.md §9.2`; retain explicit X rows and nested cut qualifiers. `_s-additions` supplies S subfacts only. Type 20 does not date individual foods."
        "note.009.row.003.source.file" "5_Constraints.md"
        "note.009.row.003.source.start" "133"
        "note.009.row.003.source.end" "133"
        "note.009.row.003.cell.001.state" "text"
        "note.009.row.003.cell.001.text" "`static-entities.json#by-id` / `#s-additions`"
        "note.009.row.003.cell.002.state" "text"
        "note.009.row.003.cell.002.text" "A STATIC_NAMES / S additions (`_doc`, `research/research_systems.md §9.1`). Do not extend to mixed `behaviour` or unscoped `candles`; explicit fire/stomp X and alpha artifact ID 46 never establish working alpha artifact gameplay."
        "note.009.row.004.source.file" "5_Constraints.md"
        "note.009.row.004.source.start" "134"
        "note.009.row.004.source.end" "134"
        "note.009.row.004.cell.001.state" "text"
        "note.009.row.004.cell.001.text" "`mission-types.json#{alpha,steam}`"
        "note.009.row.004.cell.002.state" "text"
        "note.009.row.004.cell.002.text" "A / S catalog scopes (`research/research_creatures_quests.md §7.1–2`); `alpha.quests-cut` stays X. `_shared` and completion-order are source rules/guide metadata, not missions."
        "note.009.row.005.source.file" "5_Constraints.md"
        "note.009.row.005.source.start" "135"
        "note.009.row.005.source.end" "135"
        "note.009.row.005.cell.001.state" "text"
        "note.009.row.005.cell.001.text" "`rarities.json#{mob-strength-tiers-s,alpha-relative-colors}`"
        "note.009.row.005.cell.002.state" "text"
        "note.009.row.005.cell.002.text" "S / A comparison facts only; do not propagate through rarity references."
        "note.009.row.006.source.file" "5_Constraints.md"
        "note.009.row.006.source.start" "136"
        "note.009.row.006.source.end" "136"
        "note.009.row.006.cell.001.state" "text"
        "note.009.row.006.cell.001.text" "`stats.json#{alpha-item-stat-formulas,alpha-character-formulas}`"
        "note.009.row.006.cell.002.state" "text"
        "note.009.row.006.cell.002.text" "A formula sources explicitly identify coremaze 0.1.1 reverse engineering / cuwo; this does not resolve uncertain formula correctness."
        "note.009.row.007.source.file" "5_Constraints.md"
        "note.009.row.007.source.start" "137"
        "note.009.row.007.source.end" "137"
        "note.009.row.007.cell.001.state" "text"
        "note.009.row.007.cell.001.text" "`audio.json#sfx-alpha-ids`"
        "note.009.row.007.cell.002.state" "text"
        "note.009.row.007.cell.002.text" "A identifier-list origin (`research/research_systems.md §8`), not asset availability or dates for tracks."
        "note.009.row.008.source.file" "5_Constraints.md"
        "note.009.row.008.source.start" "138"
        "note.009.row.008.source.end" "138"
        "note.009.row.008.cell.001.state" "text"
        "note.009.row.008.cell.001.text" "`equipment-slots.json#slots` and `#extra.consumable`"
        "note.009.row.008.cell.002.state" "text"
        "note.009.row.008.cell.002.text" "A storage-table / separate consumable-field origin (`research/research_systems.md §5.1/§9.2`); preserve partly inferred indices and row/subfact annotations. Approved hybrid slot rules remain independent. No A+S blanket on equip rules."
        "note.009.row.009.source.file" "5_Constraints.md"
        "note.009.row.009.source.start" "139"
        "note.009.row.009.source.end" "139"
        "note.009.row.009.cell.001.state" "text"
        "note.009.row.009.cell.001.text" "Explicit source subfacts in mixed containers"
        "note.009.row.009.cell.002.state" "text"
        "note.009.row.009.cell.002.text" "`economy.json#{currency,incomes,prices}.{A,S}`, `#shops.weapon-shop.stock.{A,S}`, `#shops.item-shop.sells.{A,S}`, `#rules.buy-back.{A,S}`, `#loot.{A-boss,A-dungeon,S-mission,S-dungeon}`; `recipes.json#crafting-tabs-a`, `#recipe-sources.{A,S}`, `#customization.{spirit-cubes-a,fully-modded-legendary-plus-s}`; `buildings.json#map-visibility.{A,S}`, `audio.json#ambient.{S,Ω}`, `key-items.json#counts-per-land-s`: only the explicitly named source subfact, never the whole mixed parent. Excluded regional mechanics remain reference."
        "note.009.row.010.source.file" "5_Constraints.md"
        "note.009.row.010.source.start" "140"
        "note.009.row.010.source.end" "140"
        "note.009.row.010.cell.001.state" "text"
        "note.009.row.010.cell.001.text" "Explicit generator source sections"
        "note.009.row.010.cell.002.state" "text"
        "note.009.row.010.cell.002.text" "`generators.json#world-scales.{alpha,steam}`, `#seed.{alpha-default,alpha-source,steam}`, `#land.{alpha-level,alpha-rarity,steam-tiers,steam-per-land,alpha-per-land}`, `#settlement.{alpha-count,steam-count,districts-alpha,inn.A,inn.S}`, `#dungeon.{alpha-layout,steam-layout,traps-alpha,traps-data-x,boss.A,boss.S,artifact-s,size-cap-s}`, `#boss.{alpha-size-scaling,alpha-spirit-drop,steam-loot,coins-s}`, `#npc-appearance.omega`, `#{coarse-map-omega,key-items-s,level-formulas-alpha,network-alpha}`: A/S/X/Ω only as explicitly identified there; preserve local hybrid overrides, never tag all generators A+S."
        "note.009.source.file" "5_Constraints.md"
        "note.009.source.start" "129"
        "note.009.source.end" "140"
        "note.010.kind" "paragraph"
        "note.010.line.001.state" "text"
        "note.010.line.001.text" "Untagged histories outside these scopes remain **source research/attribution**, not guessed"
        "note.010.line.002.state" "text"
        "note.010.line.002.text" "labels or new gameplay ballots: individual foods; roster and embedded family traits; affix"
        "note.010.line.003.state" "text"
        "note.010.line.003.text" "prefixes; mixed recipe/shop/population/UI facts; unscoped audio, static behavior/candles and"
        "note.010.line.004.state" "text"
        "note.010.line.004.text" "dialogue/example claims. The mixed food table in `research/research_items.md §5` supplies"
        "note.010.line.005.state" "text"
        "note.010.line.005.text" "pairings, not per-food A+S history; preserve existing sourced S/X food facts and F11 Banana Mash."
        "note.010.line.006.state" "text"
        "note.010.line.006.text" "Neither referenced species nor numeric IDs lend tags. `status-effects.json#ability-buffs` points"
        "note.010.line.007.state" "text"
        "note.010.line.007.text" "to existing definitions; `#not-found` creates none. `versions.json` keeps its history schema"
        "note.010.line.008.state" "text"
        "note.010.line.008.text" "(dates and scalar release identifiers, not content-tag arrays); cuwo command lists keep their"
        "note.010.line.009.state" "text"
        "note.010.line.009.text" "modded-server context, not stock-command or hybrid approval. No new labels or parser schema"
        "note.010.line.010.state" "text"
        "note.010.line.010.text" "are selected for these remaining cases. Subsequent bounded findings and unresolved scope are"
        "note.010.line.011.state" "text"
        "note.010.line.011.text" "recorded in item 6 (§3.4 `pet-food`) and item 7 below, not whole-container attribution."
        "note.010.source.file" "5_Constraints.md"
        "note.010.source.start" "142"
        "note.010.source.end" "152"
        "note.011.kind" "paragraph"
        "note.011.line.001.state" "text"
        "note.011.line.001.text" "**Check boundaries.** Load checks concern the above definitions/config, including required"
        "note.011.line.002.state" "text"
        "note.011.line.002.text" "presence before iteration, valid references/shapes and cumulative errors under item 9. Numeric"
        "note.011.line.003.state" "text"
        "note.011.line.003.text" "predicates remain in the constraint catalog; no duplicate balance table is introduced here."
        "note.011.source.file" "5_Constraints.md"
        "note.011.source.start" "154"
        "note.011.source.end" "156"
        "note.012.kind" "table"
        "note.012.column.001.text" "rules"
        "note.012.column.002.text" "definition/config load"
        "note.012.column.003.text" "generated objects, runtime and save/import checks"
        "note.012.row.001.source.file" "5_Constraints.md"
        "note.012.row.001.source.start" "160"
        "note.012.row.001.source.end" "160"
        "note.012.row.001.cell.001.state" "text"
        "note.012.row.001.cell.001.text" "Class/spec/tree"
        "note.012.row.001.cell.002.state" "text"
        "note.012.row.001.cell.002.text" "Both reference directions, two specs with distinct indices 0/1 and index 0 first, shared roots/links, Assassin exception and ability config coverage."
        "note.012.row.001.cell.003.state" "text"
        "note.012.row.001.cell.003.text" "Starting spec; spend/prerequisite/bank/respec, costs/cooldowns and actual effects."
        "note.012.row.002.source.file" "5_Constraints.md"
        "note.012.row.002.source.start" "161"
        "note.012.row.002.source.end" "161"
        "note.012.row.002.cell.001.state" "text"
        "note.012.row.002.cell.001.text" "Items/stats/recipes"
        "note.012.row.002.cell.002.state" "text"
        "note.012.row.002.cell.002.text" "Types, materials, slots, wand hands/recipe, capacities, formula/ingredient/station references and approved configuration."
        "note.012.row.002.cell.003.state" "text"
        "note.012.row.002.cell.003.text" "Generated rarity/roll/stats/names; actual upgrades and equip class/slot/hand/power limits, stacks, transactions and recipe knowledge/duplicates/locks. Generated-rarity checks do not remove mythical/worn reference definitions."
        "note.012.row.003.source.file" "5_Constraints.md"
        "note.012.row.003.source.start" "162"
        "note.012.row.003.source.end" "162"
        "note.012.row.003.cell.001.state" "text"
        "note.012.row.003.cell.001.text" "Families/pets"
        "note.012.row.003.cell.002.state" "text"
        "note.012.row.003.cell.002.text" "Primary/descriptive references, roster IDs, food pairings/source identity and rideability."
        "note.012.row.003.cell.003.state" "text"
        "note.012.row.003.cell.003.text" "Primary-only scaling, per-dog 1% generation/Collie fallback, normal dog behavior, taming/one-active-pet and training/item/equip traversal gates. Provenance is not inferred from these relations."
        "note.012.row.004.source.file" "5_Constraints.md"
        "note.012.row.004.source.start" "163"
        "note.012.row.004.source.end" "163"
        "note.012.row.004.cell.001.state" "text"
        "note.012.row.004.cell.001.text" "Artifacts (`c-artifact-stat`, §3.4)"
        "note.012.row.004.cell.002.state" "text"
        "note.012.row.004.cell.002.text" "Seven-kind `key-items.json#artifact.stat-kinds` definition and `generators.json#design.artifact` conforming to the approved normalized logarithm (5% first, positive adjustable z, initial z=0.1, no decay/1% floor). Old decay/floor cannot pass as an alternate."
        "note.012.row.004.cell.003.state" "text"
        "note.012.row.004.cell.003.text" "Generation: exactly one approved traversal kind plus attack and max HP. Runtime: matching contributors per traversal stat, all artifacts for attack/HP, equal additive shares of the logarithmic total, recalculated from current artifact-free stats. No levels or gate bypass; personal source claims follow §3.7."
        "note.012.row.005.source.file" "5_Constraints.md"
        "note.012.row.005.source.start" "164"
        "note.012.row.005.source.end" "164"
        "note.012.row.005.cell.001.state" "text"
        "note.012.row.005.cell.001.text" "World/settlement/mission (§6)"
        "note.012.row.005.cell.002.state" "text"
        "note.012.row.005.cell.002.text" "Bounds/scales, climate rule shapes and parseability, rosters/styles/buildings/roles, sites/rewards and generator config."
        "note.012.row.005.cell.003.state" "text"
        "note.012.row.005.cell.003.text" "Seeded geography, finite bounds, exact-one settlement, placement/count/lock/wave/boss-fit/loot invariants; map/travel boundary, protected settlements, clock/inn/reset/occupied-site rules and nonrenewing permanent claims. No generated-world census at load time."
        "note.012.row.006.source.file" "5_Constraints.md"
        "note.012.row.006.source.start" "165"
        "note.012.row.006.source.end" "165"
        "note.012.row.006.cell.001.state" "text"
        "note.012.row.006.cell.001.text" "AI/combat"
        "note.012.row.006.cell.002.state" "text"
        "note.012.row.006.cell.002.text" "Ability/status/moveset/projectile/role references and numeric config, including simulation-radius relationship."
        "note.012.row.006.cell.003.state" "text"
        "note.012.row.006.cell.003.text" "Threat pairs/order/target eligibility, pack response, home return, actual hit/damage/status/dodge/block/combo behavior and live panel time. Valid config alone proves none of these effects."
        "note.012.row.007.source.file" "5_Constraints.md"
        "note.012.row.007.source.start" "166"
        "note.012.row.007.source.end" "166"
        "note.012.row.007.cell.001.state" "text"
        "note.012.row.007.cell.001.text" "Persistence/authority (§3.7)"
        "note.012.row.007.cell.002.state" "text"
        "note.012.row.007.cell.002.text" "Available rule/config definitions only; no invented save format or transport."
        "note.012.row.007.cell.003.state" "text"
        "note.012.row.007.cell.003.text" "Server-validated actions/outcomes; portable versus character/world versus shared-world ownership; source claims, no downtime catch-up and surviving-mob retention. Validate imports against current rules; reject invalid imports with explanation and original save untouched, not conversion or a claim of earned-progression proof."
        "note.012.row.008.source.file" "5_Constraints.md"
        "note.012.row.008.source.start" "167"
        "note.012.row.008.source.end" "167"
        "note.012.row.008.cell.001.state" "text"
        "note.012.row.008.cell.001.text" "UI/engine/assets"
        "note.012.row.008.cell.002.state" "text"
        "note.012.row.008.cell.002.text" "Canonical action/profile reference closure, binding/UI/sound/format declarations and frame-budget config; no historical control fallback."
        "note.012.row.008.cell.003.state" "text"
        "note.012.row.008.cell.003.text" "Player-name input limits, actual RGB payloads, map/input/HUD/feedback and physics/catch-up behavior; nonexistent generated payloads are not malformed definitions."
        "note.012.source.file" "5_Constraints.md"
        "note.012.source.start" "158"
        "note.012.source.end" "167"
        "note.013.kind" "paragraph"
        "note.013.line.001.state" "text"
        "note.013.line.001.text" "Future regressions must exercise each predicate at its mapped boundary, including item 9's"
        "note.013.line.002.state" "text"
        "note.013.line.002.text" "missing-whole-input cases. A passing current validator does not prove this mapping's enforcement;"
        "note.013.line.003.state" "text"
        "note.013.line.003.text" "direct data correction and loader/validator/generator/runtime work remain unauthorized."
        "note.013.source.file" "5_Constraints.md"
        "note.013.source.start" "169"
        "note.013.source.end" "171"
    }
}

r_5_constraint_catalog = element "5-constraint-catalog" "SectionNote" {
    tags "SectionNote,Overview"
    properties {
        "id" "5-constraint-catalog"
        "kind" "SectionNote"
        "order" "173"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "5_Constraints.md"
        "source.start" "173"
        "source.end" "252"
