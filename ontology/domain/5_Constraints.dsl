        "source.start" "182"
        "source.end" "182"
        "rule.state" "text"
        "rule.text" "hybrid: gliding requires 5 Climbing points, ≥1 Hang Gliding point and a Hang Glider bought from an item vendor and equipped in the single special slot; buying alone is insufficient; further Hang Gliding points improve speed (§3.5)"
        "layer.state" "text"
        "layer.text" "runtime (deferred)"
    }
}

r_c_sailing = element "c-sailing" "Constraint" {
