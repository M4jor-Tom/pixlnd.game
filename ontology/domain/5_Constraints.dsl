        "source.file" "5_Constraints.md"
        "source.start" "193"
        "source.end" "193"
        "rule.state" "text"
        "rule.text" "hybrid: book-learned recipes remain known to that character across lands and sessions, with no relearning on travel, including between worlds under persistence item 1 (§3.7 save-data)"
        "layer.state" "text"
        "layer.text" "runtime+save-data (deferred)"
    }
}

