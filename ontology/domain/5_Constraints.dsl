        "source.file" "5_Constraints.md"
        "source.start" "199"
        "source.end" "199"
        "rule.state" "text"
        "rule.text" "hybrid: basic climbing needs neither points nor Spikes; Climbing points reduce stamina drain and global Climbing Spikes reduce consumption by 75%, not eliminate it; 5 Climbing points remain a Hang Gliding prerequisite; item 5 applies Spikes after skill reduction (remaining cost ×0.25), never additive percentage points; no skill curve/floor or artifact-combination rule inferred (§3.4/§3.5)"
        "layer.state" "text"
        "layer.text" "runtime (deferred)"
    }
}

