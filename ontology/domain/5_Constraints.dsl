r_c_power_gate = element "c-power-gate" "Constraint" {
    tags "Constraint,Catalog"
    properties {
        "id" "c-power-gate"
        "kind" "Constraint"
        "order" "192"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
