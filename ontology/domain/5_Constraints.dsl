        "layer.text" "runtime (deferred)"
    }
}

r_c_creature_family = element "c-creature-family" "Constraint" {
    tags "Constraint,Catalog"
    properties {
        "id" "c-creature-family"
        "kind" "Constraint"
        "order" "184"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "5_Constraints.md"
        "source.start" "184"
        "source.end" "184"
        "rule.state" "text"
        "rule.text" "primary and descriptive references name defined creature families; at most one primary per creature, consistent with §3.2 approved assignments; without a primary, the family modifier is ×1.0 and other ordinary stat calculations remain; descriptive memberships never supply or stack family stat modifiers, nor imply species-trait inheritance"
        "layer.state" "text"
        "layer.text" "load+runtime (deferred)"
    }
}

r_c_skeleton_dog_encounter = element "c-skeleton-dog-encounter" "Constraint" {
    tags "Constraint,Catalog"
    properties {
        "id" "c-skeleton-dog-encounter"
        "kind" "Constraint"
        "order" "185"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "5_Constraints.md"
        "source.start" "185"
        "source.end" "185"
        "rule.state" "text"
        "rule.text" "Skeleton Dog has an independent 1% chance per individual dog spawn, not per pack, all creatures or a relative species weight; mixed packs are permitted and no quota is guaranteed; applies wherever dogs already spawn, preserving settlement safety; existing skeleton-only dog encounters use Collie for ordinary outcomes, preserving dog frequency/pack sizes and other existing ordinary selections, not extra unrestricted skeletal spawns (§3.2)"
        "layer.state" "text"
        "layer.text" "generator (deferred)"
    }
}

r_c_skeleton_dog_taming = element "c-skeleton-dog-taming" "Constraint" {
    tags "Constraint,Catalog"
    properties {
        "id" "c-skeleton-dog-taming"
        "kind" "Constraint"
        "order" "186"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "5_Constraints.md"
        "source.start" "186"
        "source.end" "186"
        "rule.state" "text"
        "rule.text" "Skeleton Dogs follow normal dog behavior for the same encounter/state, including retaliation, pack response and taming reactions, with no skeleton-only passivity exception (§3.2 item 8); Bubble Gum tames them under general eligibility restrictions and settlement protection (§3.2 item 9)"
        "layer.state" "text"
        "layer.text" "runtime+data (deferred)"
    }
}

r_c_food_id = element "c-food-id" "Constraint" {
    tags "Constraint,Catalog"
    properties {
        "id" "c-food-id"
        "kind" "Constraint"
        "order" "187"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "5_Constraints.md"
        "source.start" "187"
        "source.end" "187"
        "rule.state" "text"
        "rule.text" "pet-food.tames names defined creatures by stable ID and agrees with each creature's tame-food; normally the food subtype matches its species' known source entity ID (alpha or post-alpha, no alpha-range clamp); the sole approved shared-food exception is Bubble Gum → Collie and Skeleton Dog, retaining subtype 19 from Collie without assigning it to Skeleton Dog; other pairings/IDs are unchanged (§3.4)"
        "layer.state" "text"
        "layer.text" "load (shared-food support deferred)"
    }
}

