r_c_control_references = element "c-control-references" "Constraint" {
    tags "Constraint,Catalog"
    properties {
        "id" "c-control-references"
        "kind" "Constraint"
        "order" "177"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "5_Constraints.md"
        "source.start" "177"
        "source.end" "177"
        "rule.state" "text"
        "rule.text" "action IDs are unique and resolve in [controls](controls.dsl); profiles and inert action references resolve there; every binding names its profile and distinct action meaning(s); shared physical inputs/aliases never merge intentions or add a fifth class skill; Assassin has only third-slot Camouflage; unselected mappings remain explicit, without physical defaults in canonical actions"
        "layer.state" "text"
        "layer.text" "documentation + scoped Android first-slice load checks; broader enforcement deferred"
    }
}

