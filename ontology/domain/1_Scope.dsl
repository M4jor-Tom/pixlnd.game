// Authoritative domain records. source.* coordinates refer only to baseline 175e0c59b6a05ead62d29bd851085cd5a3818378.
r_1_1_scope = element "1-1-scope" "SectionNote" {
    tags "SectionNote,Overview"
    properties {
        "id" "1-1-scope"
        "kind" "SectionNote"
        "order" "1"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "1_Scope.md"
        "source.start" "1"
        "source.end" "51"
        "title" "1. Scope"
        "heading.level" "2"
        "heading.slug" "1-scope"
        "section" "Overview"
        "note.001.kind" "paragraph"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "**Reference domain:** a seed-driven voxel, third-person action RPG, historically described as"
        "note.001.line.002.state" "text"
        "note.001.line.002.text" "“infinite” (not the hybrid bound below), with 8 races ×"
        "note.001.line.003.state" "text"
        "note.001.line.003.text" "4 classes × 2 specializations, procedurally generated lands (biomes, dungeons, settlements,"
        "note.001.line.004.state" "text"
        "note.001.line.004.text" "missions), a tame-anything pet system, crafting, and drop-in co-op. The original Cube World"
        "note.001.line.005.state" "text"
        "note.001.line.005.text" "shipped two rulesets with **mutually exclusive progression**; these are historical comparisons,"
        "note.001.line.006.state" "text"
        "note.001.line.006.text" "not additional playable modes in pixlnd. The chosen hybrid target is listed alongside them:"
        "note.001.source.file" "1_Scope.md"
        "note.001.source.start" "3"
        "note.001.source.end" "8"
        "note.002.kind" "table"
        "note.002.column.001.text" "Ruleset"
        "note.002.column.002.text" "Progression"
        "note.002.column.003.text" "Gear scope"
        "note.002.column.004.text" "Traversal unlocks"
        "note.002.column.005.text" "Fast travel"
        "note.002.row.001.source.file" "1_Scope.md"
        "note.002.row.001.source.start" "12"
        "note.002.row.001.source.end" "12"
        "note.002.row.001.cell.001.state" "text"
        "note.002.row.001.cell.001.text" "`ruleset-alpha` (A)"
        "note.002.row.001.cell.002.state" "text"
        "note.002.row.001.cell.002.text" "XP → levels → 2 skill points/level, skill tree, item power +1..+100"
        "note.002.row.001.cell.003.state" "text"
        "note.002.row.001.cell.003.text" "global, Adaptation re-levels gear"
        "note.002.row.001.cell.004.state" "text"
        "note.002.row.001.cell.004.text" "skill tree + bought glider/boat"
        "note.002.row.001.cell.005.state" "text"
        "note.002.row.001.cell.005.text" "portals (rune stones), revival statues"
        "note.002.row.002.source.file" "1_Scope.md"
        "note.002.row.002.source.start" "13"
        "note.002.row.002.source.end" "13"
        "note.002.row.002.cell.001.state" "text"
        "note.002.row.002.cell.001.text" "`ruleset-steam` (S)"
        "note.002.row.002.cell.002.state" "text"
        "note.002.row.002.cell.002.text" "no XP; level = artifacts found; gear is the only combat power"
        "note.002.row.002.cell.003.state" "text"
        "note.002.row.002.cell.003.text" "**region-locked**; `+` items work in adjacent regions"
        "note.002.row.002.cell.004.state" "text"
        "note.002.row.002.cell.004.text" "per-region key items + artifacts"
        "note.002.row.002.cell.005.state" "text"
        "note.002.row.002.cell.005.text" "shrines of life, flight masters"
        "note.002.row.003.source.file" "1_Scope.md"
        "note.002.row.003.source.start" "14"
        "note.002.row.003.source.end" "14"
        "note.002.row.003.cell.001.state" "text"
        "note.002.row.003.cell.001.text" "**`ruleset-hybrid` (chosen)**"
        "note.002.row.003.cell.002.state" "text"
        "note.002.row.003.cell.002.text" "alpha XP/levels/skill tree"
        "note.002.row.003.cell.003.state" "text"
        "note.002.row.003.cell.003.text" "global, never degrades"
        "note.002.row.003.cell.004.state" "text"
        "note.002.row.003.cell.004.text" "skill tree + key items (global once found) + artifacts"
        "note.002.row.003.cell.005.state" "text"
        "note.002.row.003.cell.005.text" "portals, shrines, flight masters"
        "note.002.source.file" "1_Scope.md"
        "note.002.source.start" "10"
        "note.002.source.end" "14"
        "note.003.kind" "paragraph"
        "note.003.line.001.state" "text"
        "note.003.line.001.text" "Everything else (world, creatures, weapons, combat feel, crafting stations, pets, settlements) is"
        "note.003.line.002.state" "text"
        "note.003.line.002.text" "shared with version-specific deltas."
        "note.003.source.file" "1_Scope.md"
        "note.003.source.start" "16"
        "note.003.source.end" "17"
        "note.004.kind" "paragraph"
        "note.004.line.001.state" "text"
        "note.004.line.001.text" "**Decision D1 (owner, 2026-09-07): ship `ruleset-hybrid`.** Alpha progression (XP → levels →"
        "note.004.line.002.state" "text"
        "note.004.line.002.text" "skill points, skill tree, item power, adaptation, spirit cubes, formulas) **plus** approved Steam"
        "note.004.line.003.state" "text"
        "note.004.line.003.text" "content, subject to D3/D4 and subsequent approvals (key items, artifacts, lore, arenas, factions"
        "note.004.line.004.state" "text"
        "note.004.line.004.text" "and events, shrines, flight masters, elixirs, gnome suppliers, books of crafting)."
        "note.004.line.005.state" "text"
        "note.004.line.005.text" "**Region lock is dropped** (D4): equipment never loses power"
        "note.004.line.006.state" "text"
        "note.004.line.006.text" "when the character travels; there are no `+` items, no `worn` degradation, no per-land inventory"
        "note.004.line.007.state" "text"
        "note.004.line.007.text" "pages, and key items work everywhere once found. Artifacts stay as permanent collectibles"
        "note.004.line.008.state" "text"
        "note.004.line.008.text" "with traversal and D6 attack/maximum-HP rewards, but do not grant character levels."
        "note.004.line.009.state" "text"
        "note.004.line.009.text" "Flags in `instances/rulesets.json#ruleset-hybrid`."
        "note.004.line.010.state" "text"
        "note.004.line.010.text" "Alpha/Steam rulesets remain documented for reference only."
        "note.004.source.file" "1_Scope.md"
        "note.004.source.start" "19"
        "note.004.source.end" "28"
        "note.005.kind" "paragraph"
        "note.005.line.001.state" "text"
        "note.005.line.001.text" "**Permanent exclusion (owner reaffirmed 2026-09-15):** never propose or implement regional"
        "note.005.line.002.state" "text"
        "note.005.line.002.text" "gear power loss in pixlnd, even for Cube World cloning fidelity. This is not a v2 deferral or"
        "note.005.line.003.state" "text"
        "note.005.line.003.text" "an alternative mode. Historical region-lock data is reference only, never an implementation target."
        "note.005.source.file" "1_Scope.md"
        "note.005.source.start" "30"
        "note.005.source.end" "32"
        "note.006.kind" "paragraph"
        "note.006.line.001.state" "text"
        "note.006.line.001.text" "**Hybrid v1 scope (item 8, owner approved 2026-09-15):** the approved hybrid above, with D1–D26"
        "note.006.line.002.state" "text"
        "note.006.line.002.text" "and subsequent reconciliation approvals preserved. Ontology coverage is broader than v1:"
        "note.006.line.003.state" "text"
        "note.006.line.003.text" "`X` cut/data-only content and `Ω`-only announcements are reference/roadmap material, not launch"
        "note.006.line.004.state" "text"
        "note.006.line.004.text" "availability, even if a historical flag is true. Their existing definitions and provenance remain."
        "note.006.line.005.state" "text"
        "note.006.line.005.text" "**Current-build coverage:** dated slice notes and `generators.json#design` describe approved"
        "note.006.line.006.state" "text"
        "note.006.line.006.text" "implementation stages, including temporary approximations, not proof that the final target is"
        "note.006.line.007.state" "text"
        "note.006.line.007.text" "implemented. Later decisions supersede earlier placeholders. Current decision/research status"
        "note.006.line.008.state" "text"
        "note.006.line.008.text" "is indexed in [§7 (locator=7-open-points-for-validation)](7_Open_points_for_validation.dsl);"
        "note.006.line.009.state" "text"
        "note.006.line.009.text" "this scope clarification does not authorize gameplay changes."
        "note.006.line.010.state" "text"
        "note.006.line.010.text" "**Out of scope:** Picroma's engine internals (Plasma GUI runtime, DX11 renderer), the exact"
        "note.006.line.011.state" "text"
        "note.006.line.011.text" "network byte layout of the 2013 protocol (kept as reference only), Steam platform integration,"
        "note.006.line.012.state" "text"
        "note.006.line.012.text" "Omega content beyond what was publicly announced."
        "note.006.line.013.state" "text"
        "note.006.line.013.text" "**Roadmap, not a release promise:** cut content and Omega-only systems (weather, procedural body"
        "note.006.line.014.state" "text"
        "note.006.line.014.text" "parts, signature abilities per species, coarse-map-first generation) remain in `docs/ROADMAP/`"
        "note.006.line.015.state" "text"
        "note.006.line.015.text" "under D3/D4. Modeling them does not authorize enabling them; a later inclusion needs owner approval."
        "note.006.source.file" "1_Scope.md"
        "note.006.source.start" "34"
        "note.006.source.end" "48"
    }
}
