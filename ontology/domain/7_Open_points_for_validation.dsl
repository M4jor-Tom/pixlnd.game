r_7_current_hybrid_decision_status_2026_10_17 = element "7-current-hybrid-decision-status-2026-10-17" "SectionNote" {
    tags "SectionNote,Overview"
    properties {
        "id" "7-current-hybrid-decision-status-2026-10-17"
        "kind" "SectionNote"
        "order" "3"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "7_Open_points_for_validation.md"
        "source.start" "3"
        "source.end" "16"
        "title" "Current hybrid decision status (2026-10-17)"
        "heading.level" "3"
        "heading.slug" "current-hybrid-decision-status-2026-10-17"
        "section" "Overview"
        "note.001.kind" "paragraph"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "The four selected gameplay choices are resolved in canonical definitions:"
        "note.001.line.002.state" "text"
        "note.001.line.002.text" "[landscape availability (locator=landscape)](3_Classes.dsl), [ordinary Lion tameability (locator=creature)](3_Classes.dsl),"
        "note.001.line.003.state" "text"
        "note.001.line.003.text" "[Resistance meaning (locator=stat)](3_Classes.dsl) and [fixed gear HP (locator=item)](3_Classes.dsl)."
        "note.001.line.004.state" "text"
        "note.001.line.004.text" "No unresolved entry remains in the game-choice backlog. Resistance's five approved combat"
        "note.001.line.005.state" "text"
        "note.001.line.005.text" "selections, including defence order and dependencies, are [defined under stat (locator=stat)](3_Classes.dsl)"
        "note.001.line.006.state" "text"
        "note.001.line.006.text" "and constrained by the [mitigation rules (locator=constraint-catalog)](5_Constraints.dsl)."
        "note.001.line.007.state" "text"
        "note.001.line.007.text" "Combat hit-derived burning and poison have [independent-application rules (locator=status-effect)](3_Classes.dsl)."
        "note.001.source.file" "7_Open_points_for_validation.md"
        "note.001.source.start" "5"
        "note.001.source.end" "11"
        "note.002.kind" "paragraph"
        "note.002.line.001.state" "text"
        "note.002.line.001.text" "Implementation remains separately unauthorized; see"
        "note.002.line.002.state" "text"
        "note.002.line.002.text" "[deferred work](../../docs/ROADMAP/todo_implement.md). Documentation is not runtime coverage"
        "note.002.line.003.state" "text"
        "note.002.line.003.text" "or permission to invent additional rules from Resistance's meaning."
        "note.002.source.file" "7_Open_points_for_validation.md"
        "note.002.source.start" "13"
        "note.002.source.end" "15"
    }
}

r_7_reference_uncertainties_not_new_hybrid_defaults = element "7-reference-uncertainties-not-new-hybrid-defaults" "SectionNote" {
    tags "SectionNote,Overview"
    properties {
        "id" "7-reference-uncertainties-not-new-hybrid-defaults"
        "kind" "SectionNote"
        "order" "17"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "7_Open_points_for_validation.md"
        "source.start" "17"
        "source.end" "26"
        "title" "Reference uncertainties, not new hybrid defaults"
        "heading.level" "3"
        "heading.slug" "reference-uncertainties-not-new-hybrid-defaults"
        "section" "Overview"
        "note.001.kind" "paragraph"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "Historical Swamp Lands identity, disputed Lion tameability, conflicting Resistance descriptions"
        "note.001.line.002.state" "text"
        "note.001.line.002.text" "and the disputed historical gear-HP roll expression remain research uncertainties, not alternate"
        "note.001.line.003.state" "text"
        "note.001.line.003.text" "hybrid rules. Rare-zone rarity, the alpha `mana-cubes` field, species-specific chase observations,"
        "note.001.line.004.state" "text"
        "note.001.line.004.text" "source stat-display comparisons and Omega engine/status reports also remain uncertain."
        "note.001.line.005.state" "text"
        "note.001.line.005.text" "They neither override designed hybrid rules nor enable cut/Omega content. Other `?` annotations"
        "note.001.line.006.state" "text"
        "note.001.line.006.text" "stay attached to their source records; any unresolved implication for active hybrid behavior"
        "note.001.line.007.state" "text"
        "note.001.line.007.text" "must be decided before implementation, not inferred from a historical flag or loader fallback."
        "note.001.line.008.state" "text"
        "note.001.line.008.text" "Research is not exhausted by resolving the selected gameplay choices."
        "note.001.source.file" "7_Open_points_for_validation.md"
        "note.001.source.start" "19"
        "note.001.source.end" "26"
    }
}
