r_combat_block = element "combat-block" "Class" {
    tags "Class,Combat"
    properties {
        "id" "combat-block"
        "kind" "Class"
        "order" "895"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "3_Classes.md"
        "source.start" "895"
        "source.end" "910"
        "title" "combat-block"
        "heading.level" "3"
        "heading.slug" "combat-block"
        "section" "Combat"
        "note.001.kind" "paragraph"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "Defensive action, distinct from the terrain [block (locator=block)](3_Classes.dsl)."
        "note.001.line.002.state" "text"
        "note.001.line.002.text" "[Block (locator=block)](controls.dsl) with shield (Guardian: any weapon; any warrior during Cyclone); drains `block-power`,"
        "note.001.line.003.state" "text"
        "note.001.line.003.text" "regenerates when not blocking (faster during Cyclone); successful block gives MP (D11:"
        "note.001.line.004.state" "text"
        "note.001.line.004.text" "the bar specials spend); Guardian block power ×2. `A S`"
        "note.001.line.005.state" "text"
        "note.001.line.005.text" "Hybrid (D23): numbers `design.defence.block`. Block and special attack are distinct intentions;"
        "note.001.line.006.state" "text"
        "note.001.line.006.text" "the current simultaneous hold coupling belongs to the [keyboard profile (locator=keyboard-and-mouse)](controller-profiles.dsl)."
        "note.001.source.file" "3_Classes.md"
        "note.001.source.start" "896"
        "note.001.source.end" "901"
        "note.002.kind" "paragraph"
        "note.002.line.001.state" "text"
        "note.002.line.001.text" "Hybrid exhaustion (walkthrough item 10, runtime repair authorized 2026-09-17): judge each hit"
        "note.002.line.002.state" "text"
        "note.002.line.002.text" "using the block-power available when it arrives. An eligible hit with positive power is blocked"
        "note.002.line.003.state" "text"
        "note.002.line.003.text" "normally, even if its cost empties the bar; its attached statuses remain blocked too. Subsequent"
        "note.002.line.004.state" "text"
        "note.002.line.004.text" "hits at zero power receive neither block reduction nor block MP rewards or status protection,"
        "note.002.line.005.state" "text"
        "note.002.line.005.text" "even before the next defence update. Other defences still apply. Preserve all block numbers,"
        "note.002.line.006.state" "text"
        "note.002.line.006.text" "regeneration, Guardian and Cyclone rules. Authorization covers only this repair and its regression;"
        "note.002.line.007.state" "text"
        "note.002.line.007.text" "panel-time, combo, broader slot-model and validator fixes remain separate, deferred work."
        "note.002.source.file" "3_Classes.md"
        "note.002.source.start" "903"
        "note.002.source.end" "909"
    }
}

