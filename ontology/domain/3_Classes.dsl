r_world = element "world" "Class" {
    tags "Class,World"
    properties {
        "id" "world"
        "kind" "Class"
        "order" "9"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "3_Classes.md"
        "source.start" "9"
        "source.end" "43"
        "title" "world"
        "heading.level" "3"
        "heading.slug" "world"
        "section" "World"
        "note.001.kind" "paragraph"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "The single playable universe instance. `A S`"
        "note.001.line.002.state" "text"
        "note.001.line.002.text" "Hybrid saved-world identity is distinct from the generation seed (`save-data`, persistence item 2)."
        "note.001.source.file" "3_Classes.md"
        "note.001.source.start" "10"
        "note.001.source.end" "11"
        "note.002.kind" "paragraph"
        "note.002.line.001.state" "text"
        "note.002.line.001.text" "**Hybrid world/reset item 1 (owner approved, 2026-09-28):** the world is a finite square of"
        "note.002.line.002.state" "text"
        "note.002.line.002.text" "**1,024 × 1,024 lands (1,048,576 total)**, one land per region. Each land is **16,384 blocks"
        "note.002.line.003.state" "text"
        "note.002.line.003.text" "across** (D12), giving **16,777,216 blocks / roughly 16,777 km per side**. Land coordinates"
        "note.002.line.004.state" "text"
        "note.002.line.004.text" "run **−512 through 511 inclusive on each horizontal axis**. This is enormous but bounded,"
        "note.002.line.005.state" "text"
        "note.002.line.005.text" "not unlimited generation or a wrapping world. Historical “infinite” / “no borders” descriptions"
        "note.002.line.006.state" "text"
        "note.002.line.006.text" "do not override this hybrid limit. Boundary enforcement and live-data/checker migration remain"
        "note.002.line.007.state" "text"
        "note.002.line.007.text" "deferred; the current terrain streamer does not enforce the bound."
        "note.002.source.file" "3_Classes.md"
        "note.002.source.start" "13"
        "note.002.source.end" "19"
        "note.003.kind" "paragraph"
        "note.003.line.001.state" "text"
        "note.003.line.001.text" "**Hybrid world/reset item 2 (owner approved, 2026-09-28; depends on item 1):** mark the"
        "note.003.line.002.state" "text"
        "note.003.line.002.text" "outer world boundary on the map and **prevent outward travel**, including **flight and"
        "note.003.line.003.state" "text"
        "note.003.line.003.text" "teleport destinations**. Players can turn back; crossing attempts cause **no special damage,"
        "note.003.line.004.state" "text"
        "note.003.line.004.text" "death or forced teleport**. This chooses no edge art, warning UI, biome or numerical buffer."
        "note.003.line.005.state" "text"
        "note.003.line.005.text" "Map/travel enforcement remains deferred and unauthorized."
        "note.003.source.file" "3_Classes.md"
        "note.003.source.start" "21"
        "note.003.source.end" "25"
        "note.004.kind" "property-table"
        "property.column.001.text" "prop"
        "property.column.002.text" "type"
        "property.column.003.text" "i/e"
        "property.column.004.text" "notes"
        "property.001.name" "seed"
        "property.001.source.file" "3_Classes.md"
        "property.001.source.start" "29"
        "property.001.source.end" "29"
        "property.001.type.state" "text"
        "property.001.type.text" "uint32"
        "property.001.i-e.state" "text"
        "property.001.i-e.text" "i"
        "property.001.notes.state" "text"
        "property.001.notes.text" "A: chosen per world at creation (server default 26879); S: one fixed shared seed, no UI"
        "property.001.value.state" "absent-column"
        "property.002.name" "name"
        "property.002.source.file" "3_Classes.md"
        "property.002.source.start" "30"
        "property.002.source.end" "30"
        "property.002.type.state" "text"
        "property.002.type.text" "string"
        "property.002.i-e.state" "text"
        "property.002.i-e.text" "i"
        "property.002.notes.state" "text"
        "property.002.notes.text" "A only (world list)"
        "property.002.value.state" "absent-column"
        "property.003.name" "day"
        "property.003.source.file" "3_Classes.md"
        "property.003.source.start" "31"
        "property.003.source.end" "31"
        "property.003.type.state" "text"
        "property.003.type.text" "int"
        "property.003.i-e.state" "text"
        "property.003.i-e.text" "i"
        "property.003.notes.state" "text"
        "property.003.notes.text" "day counter"
        "property.003.value.state" "absent-column"
        "property.004.name" "time-ms"
        "property.004.source.file" "3_Classes.md"
        "property.004.source.start" "32"
        "property.004.source.end" "32"
        "property.004.type.state" "text"
        "property.004.type.text" "int 0..86_400_000"
        "property.004.i-e.state" "text"
        "property.004.i-e.text" "i"
        "property.004.notes.state" "text"
        "property.004.notes.text" "ms of game day"
        "property.004.value.state" "absent-column"
        "property.005.name" "spawn-rule"
        "property.005.source.file" "3_Classes.md"
        "property.005.source.start" "33"
        "property.005.source.end" "33"
        "property.005.type.state" "text"
        "property.005.type.text" "enum `near-village`"
        "property.005.i-e.state" "text"
        "property.005.i-e.text" "i"
        "property.005.notes.state" "text"
        "property.005.notes.text" "S 0.9.1-3: new chars spawn near a village; A: world spawn (0,0 area); hybrid (D22): the square of the land (0,0) village"
        "property.005.value.state" "absent-column"
        "property.006.name" "discovered-zones"
        "property.006.source.file" "3_Classes.md"
        "property.006.source.start" "34"
        "property.006.source.end" "34"
        "property.006.type.state" "text"
        "property.006.type.text" "set<zone-coord>"
        "property.006.i-e.state" "text"
        "property.006.i-e.text" "i"
        "property.006.notes.state" "text"
        "property.006.notes.text" "hybrid: world-shared terrain exploration (persistence item 3 below); A: shared by all visitors"
        "property.006.value.state" "absent-column"
        "property.007.name" "origin-poi"
        "property.007.source.file" "3_Classes.md"
        "property.007.source.start" "35"
        "property.007.source.end" "35"
        "property.007.type.state" "text"
        "property.007.type.text" "`poi-type` ref"
        "property.007.i-e.state" "text"
        "property.007.i-e.text" "e"
        "property.007.notes.state" "text"
        "property.007.notes.text" "S: `wollays-house` at block (0,0)"
        "property.007.value.state" "absent-column"
        "note.004.source.file" "3_Classes.md"
        "note.004.source.start" "27"
        "note.004.source.end" "35"
        "note.005.kind" "paragraph"
        "note.005.line.001.state" "text"
        "note.005.line.001.text" "Instances: none (runtime). Config: `generators.json#world-scales`."
        "note.005.source.file" "3_Classes.md"
        "note.005.source.start" "36"
        "note.005.source.end" "36"
        "note.006.kind" "paragraph"
        "note.006.line.001.state" "text"
        "note.006.line.001.text" "**Hybrid persistence item 3 (owner approved, 2026-09-28):** explored terrain belongs to"
        "note.006.line.002.state" "text"
        "note.006.line.002.text" "that saved world and is visible to all its visitors, including later arrivals. Seeing a place"
        "note.006.line.003.state" "text"
        "note.006.line.003.text" "on the shared map grants **no personal shrine activation, flight access or lore knowledge**;"
        "note.006.line.004.state" "text"
        "note.006.line.004.text" "those remain character/world records (`save-data`, item 2). Exploration helps the group, but"
        "note.006.line.005.state" "text"
        "note.006.line.005.text" "newcomers inherit the already-explored map rather than starting with a private blank map."
        "note.006.source.file" "3_Classes.md"
        "note.006.source.start" "38"
        "note.006.source.end" "42"
    }
}

