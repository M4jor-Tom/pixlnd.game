r_level_formula = element "level-formula" "Class" {
    tags "Class,Progression"
    properties {
        "id" "level-formula"
        "kind" "Class"
        "order" "1267"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "3_Classes.md"
        "source.start" "1267"
        "source.end" "1276"
        "title" "level-formula `A`"
        "heading.level" "3"
        "heading.slug" "level-formula-a"
        "section" "Progression"
        "note.001.kind" "paragraph"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "`power(lvl) = (101·lvl − 81)/(lvl + 19)` (cap +100 at lvl 1981); `xp-to-next(lvl) = int(1050 −"
        "note.001.line.002.state" "text"
        "note.001.line.002.text" "1000/(0.05·(lvl−1)+1))`; `base-hp(lvl) = 2^((1 − 1/(0.05·(lvl−1)+1))·3)`; player HP = base × 2 ×"
        "note.001.line.003.state" "text"
        "note.001.line.003.text" "max-hp-multiplier; class HP multipliers warrior 1.30 (guardian ×1.25 more), ranger 1.10, rogue 1.20,"
        "note.001.line.004.state" "text"
        "note.001.line.004.text" "mage 1.00; 2 banked skill points per level for skill-tree spending; no level cap (int32)."
        "note.001.line.005.state" "text"
        "note.001.line.005.text" "XP per kill: `generators.json#design.progression` (D19). About five even-level kills give a level;"
        "note.001.line.006.state" "text"
        "note.001.line.006.text" "creatures 10+ levels below give zero XP. Carry overflow, allowing multiple level-ups per kill"
        "note.001.line.007.state" "text"
        "note.001.line.007.text" "by subtracting each reached level's XP threshold and retaining the remainder."
        "note.001.line.008.state" "text"
        "note.001.line.008.text" "Recompute maximum HP for the new level, then refill HP."
        "note.001.source.file" "3_Classes.md"
        "note.001.source.start" "1268"
        "note.001.source.end" "1275"
    }
}

r_skill_tree = element "skill-tree" "Class" {
    tags "Class,Progression"
    properties {
        "id" "skill-tree"
        "kind" "Class"
        "order" "1277"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "3_Classes.md"
        "source.start" "1277"
        "source.end" "1325"
        "title" "skill-tree `A`"
        "heading.level" "3"
        "heading.slug" "skill-tree-a"
        "section" "Progression"
        "note.001.kind" "paragraph"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "11 slots. Shared chains (5 points unlock next): pet-master → riding; climbing → hang-gliding;"
        "note.001.line.002.state" "text"
        "note.001.line.002.text" "swimming → sailing. Class column: skill-1 (1 pt) → skill-2 (5 in skill-1) → skill-3 spec-specific"
        "note.001.line.003.state" "text"
        "note.001.line.003.text" "(5 in skill-2). Points reduce cooldown and scale one effect: +5 % effect and −5 % cooldown per"
        "note.001.line.004.state" "text"
        "note.001.line.004.text" "point, cooldown floor 25 %, uncapped (D6). Respec at class trainer."
        "note.001.line.005.state" "text"
        "note.001.line.005.text" "Hybrid (D10): retain the shared chains and Alpha class column above; add an `ultimate` column"
        "note.001.line.006.state" "text"
        "note.001.line.006.text" "holding the specialization's selected ultimate ability, unlocked by 5 points in its rank-3 skill."
        "note.001.line.007.state" "text"
        "note.001.line.007.text" "The six Alpha skills removed in Steam return in their class column."
        "note.001.line.008.state" "text"
        "note.001.line.008.text" "Assassin's single-skill exception is defined below."
        "note.001.line.009.state" "text"
        "note.001.line.009.text" "Spending (D20): [spend one banked point (locator=spend-skill-point)](controls.dsl) on the"
        "note.001.line.010.state" "text"
        "note.001.line.010.text" "[skill-tree screen (locator=skills-window)](controls.dsl) (`ui.json#screens.skills`);"
        "note.001.line.011.state" "text"
        "note.001.line.011.text" "a node opens when the previous node of its column holds `alpha-tree.needs` points (roots 0); class ranks 1–3 + ultimate"
        "note.001.line.012.state" "text"
        "note.001.line.012.text" "activate through [class skill slots 1–4 (locator=class-skill-1)](controls.dsl) (their runtimes: `design.abilities`, D21); per-point multipliers `design.skill-point`;"
        "note.001.line.013.state" "text"
        "note.001.line.013.text" "respec at the class trainer refunds every point to the bank for a fee (`design.settlement.trainer`, D22)."
        "note.001.source.file" "3_Classes.md"
        "note.001.source.start" "1278"
        "note.001.source.end" "1290"
        "note.002.kind" "paragraph"
        "note.002.line.001.state" "text"
        "note.002.line.001.text" "**Hybrid Assassin item 1 (owner approved, 2026-09-28):** Camouflage's alpha rank-3 skill and"
        "note.002.line.002.state" "text"
        "note.002.line.002.text" "Steam ultimate are **the same ability**, not separately purchased copies. After **5 Sneak"
        "note.002.line.003.state" "text"
        "note.002.line.003.text" "points**, spend at least **1 Camouflage point** to use it through **[third class skill (locator=class-skill-3)](controls.dsl)**. Assassin has **no"
        "note.002.line.004.state" "text"
        "note.002.line.004.text" "separate fourth node or fourth-slot ability**, even after five Camouflage points; `also-ultimate`"
        "note.002.line.005.state" "text"
        "note.002.line.005.text" "denotes the shared source identity, not another unlock. There is one point investment, one"
        "note.002.line.006.state" "text"
        "note.002.line.006.text" "cooldown and one buff, with no extra charge or duplicate purchase. Keep Camouflage's existing"
        "note.002.line.007.state" "text"
        "note.002.line.007.text" "effect, duration, cooldown, per-point scaling and approved stealth/threat rules unchanged."
        "note.002.line.008.state" "text"
        "note.002.line.008.text" "This is an explicit Assassin exception to D10's separate ultimate node; other specializations"
        "note.002.line.009.state" "text"
        "note.002.line.009.text" "and the remaining D10/D20 rules stand. The player has three distinct class skills rather than"
        "note.002.line.010.state" "text"
        "note.002.line.010.text" "paying twice for the same skill. Current third-slot/no-fourth-slot runtime already matches; tree metadata"
        "note.002.line.011.state" "text"
        "note.002.line.011.text" "clarification and validation coverage remain separately deferred, not authorized by this approval."
        "note.002.source.file" "3_Classes.md"
        "note.002.source.start" "1292"
        "note.002.source.end" "1302"
        "note.003.kind" "paragraph"
        "note.003.line.001.state" "text"
        "note.003.line.001.text" "Hybrid traversal item 1 (approved 2026-09-28): the riding chain also requires global Reins"
        "note.003.line.002.state" "text"
        "note.003.line.002.text" "and a rideable tamed pet; training and further-point speed benefits follow `pet` / `c-riding`."
        "note.003.source.file" "3_Classes.md"
        "note.003.source.start" "1304"
        "note.003.source.end" "1305"
        "note.004.kind" "paragraph"
        "note.004.line.001.state" "text"
        "note.004.line.001.text" "**Hybrid traversal item 2 (owner approved, 2026-09-28):** gliding requires **5 Climbing"
        "note.004.line.002.state" "text"
        "note.004.line.002.text" "points + at least 1 Hang Gliding point** and an **equipped Hang Glider bought from an item"
        "note.004.line.003.state" "text"
        "note.004.line.003.text" "vendor**. Further Hang Gliding points improve glide speed. Buying alone is insufficient;"
        "note.004.line.004.state" "text"
        "note.004.line.004.text" "the glider occupies the existing single `special` slot, not an extra slot. Live-data migration"
        "note.004.line.005.state" "text"
        "note.004.line.005.text" "and runtime enforcement remain deferred."
        "note.004.source.file" "3_Classes.md"
        "note.004.source.start" "1307"
        "note.004.source.end" "1311"
        "note.005.kind" "paragraph"
        "note.005.line.001.state" "text"
        "note.005.line.001.text" "**Hybrid traversal item 3 (owner approved, 2026-09-28):** sailing requires **5 Swimming"
        "note.005.line.002.state" "text"
        "note.005.line.002.text" "points + at least 1 Sailing point** and an **equipped Boat bought from an item vendor**."
        "note.005.line.003.state" "text"
        "note.005.line.003.text" "Further Sailing points improve sailing speed. Buying alone is insufficient; equip the boat"
        "note.005.line.004.state" "text"
        "note.005.line.004.text" "instead of the glider in the existing single `special` slot, never both. Live-data migration"
        "note.005.line.005.state" "text"
        "note.005.line.005.text" "and runtime enforcement remain deferred."
        "note.005.source.file" "3_Classes.md"
        "note.005.source.start" "1313"
        "note.005.source.end" "1317"
        "note.006.kind" "paragraph"
        "note.006.line.001.state" "text"
        "note.006.line.001.text" "**Hybrid traversal item 4 (owner corrected, 2026-09-28):** basic climbing requires **neither"
        "note.006.line.002.state" "text"
        "note.006.line.002.text" "skill points nor Spikes**. Climbing points reduce stamina drain; global Spikes reduce climbing"
        "note.006.line.003.state" "text"
        "note.006.line.003.text" "stamina consumption by **75%**, not an exemption from stamina costs (`key-item`). Five Climbing"
        "note.006.line.004.state" "text"
        "note.006.line.004.text" "points remain the Hang Gliding prerequisite under item 2. This principle does not define the"
        "note.006.line.005.state" "text"
        "note.006.line.005.text" "skill reduction curve/floor. Item 5 separately applies Spikes to the remaining skill-adjusted"
        "note.006.line.006.state" "text"
        "note.006.line.006.text" "cost (×0.25), not additive percentage points (`key-item`)."
        "note.006.source.file" "3_Classes.md"
        "note.006.source.start" "1319"
        "note.006.source.end" "1324"
    }
}

r_power_gate = element "power-gate" "Class" {
    tags "Class,Progression"
    properties {
        "id" "power-gate"
        "kind" "Class"
        "order" "1326"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "3_Classes.md"
        "source.start" "1326"
        "source.end" "1340"
        "title" "power-gate `A`"
        "heading.level" "3"
        "heading.slug" "power-gate-a"
        "section" "Progression"
        "note.001.kind" "paragraph"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "Item `+N` usable at full strength only if player power ≥ N; formulas learnable likewise."
        "note.001.source.file" "3_Classes.md"
        "note.001.source.start" "1327"
        "note.001.source.end" "1327"
        "note.002.kind" "paragraph"
        "note.002.line.001.state" "text"
        "note.002.line.001.text" "**Hybrid books/formulas item 3 (owner approved, 2026-09-28):** books record their unknown"
        "note.002.line.002.state" "text"
        "note.002.line.002.text" "recipes **immediately, regardless of current power**. A recipe above the character's power"
        "note.002.line.003.state" "text"
        "note.002.line.003.text" "remains **known but visibly locked against crafting until that power requirement is reached**."
        "note.002.line.004.state" "text"
        "note.002.line.004.text" "It is a future crafting goal, not immediate crafting access. Formula learning retains its"
        "note.002.line.005.state" "text"
        "note.002.line.005.text" "existing sufficient-power requirement; books do not bypass recipe progression or change item"
        "note.002.line.006.state" "text"
        "note.002.line.006.text" "strength, materials or station requirements."
        "note.002.source.file" "3_Classes.md"
        "note.002.source.start" "1329"
        "note.002.source.end" "1334"
        "note.003.kind" "paragraph"
        "note.003.line.001.state" "text"
        "note.003.line.001.text" "Known-but-locked recipes count as known for item 2's duplicate rules: another book teaches"
        "note.003.line.002.state" "text"
        "note.003.line.002.text" "nothing extra for them, and an already-known formula remains unconsumed. Neither source removes"
        "note.003.line.003.state" "text"
        "note.003.line.003.text" "the power lock or grants compensation for a duplicate. Runtime/UI enforcement and live-data"
        "note.003.line.004.state" "text"
        "note.003.line.004.text" "migration remain separately deferred and unauthorized."
        "note.003.source.file" "3_Classes.md"
        "note.003.source.start" "1336"
        "note.003.source.end" "1339"
    }
}

r_region_lock = element "region-lock" "Class" {
    tags "Class,Progression"
    properties {
        "id" "region-lock"
        "kind" "Class"
        "order" "1341"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "3_Classes.md"
        "source.start" "1341"
        "source.end" "1348"
        "title" "region-lock `S` — **DROPPED (D4)**"
        "heading.level" "3"
        "heading.slug" "region-lock-s--dropped-d4"
        "section" "Progression"
        "note.001.kind" "paragraph"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "Reference only. In 1.0 gear, leftovers, bombs' loot and key items were bound to origin `land`;"
        "note.001.line.002.state" "text"
        "note.001.line.002.text" "outside they became worn/grey (e.g. 194.1 → 5.4 dmg) or stopped working; `+` items kept full stats"
        "note.001.line.003.state" "text"
        "note.001.line.003.text" "in adjacent lands. The hybrid ruleset removes all of it: `item.land`, `item.plus`, `rarity.worn`,"
        "note.001.line.004.state" "text"
        "note.001.line.004.text" "`land.inventory-page` and constraints `c-region-lock` / `c-plus-adjacent` are inert."
        "note.001.line.005.state" "text"
        "note.001.line.005.text" "Permanently excluded from pixlnd: never propose or implement regional gear power loss, even"
        "note.001.line.006.state" "text"
        "note.001.line.006.text" "for cloning fidelity (owner reaffirmed 2026-09-15, §1)."
        "note.001.source.file" "3_Classes.md"
        "note.001.source.start" "1342"
        "note.001.source.end" "1347"
    }
}

