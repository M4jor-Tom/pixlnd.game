r_stealth = element "stealth" "Class" {
    tags "Class,Combat"
    properties {
        "id" "stealth"
        "kind" "Class"
        "order" "917"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "3_Classes.md"
        "source.start" "917"
        "source.end" "924"
        "title" "stealth"
        "heading.level" "3"
        "heading.slug" "stealth"
        "section" "Combat"
        "note.001.kind" "paragraph"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "Separate bar: up to +20 % attack power, +50 % crit, faster MP gain, near-zero aggro at full;"
        "note.001.line.002.state" "text"
        "note.001.line.002.text" "decays when not generated; sources: sneak (faster still / in dark, slower in daylight / near"
        "note.001.line.003.state" "text"
        "note.001.line.003.text" "lamps), assassin specials, camouflage (instant full), sniper aim `A` / charging `S`. `A S`"
        "note.001.line.004.state" "text"
        "note.001.line.004.text" "Hybrid (D23): `design.defence.stealth` + `design.abilities.<id>.stealth-per-s|stealth-full`; no darkness / lamp rule until a game clock exists."
        "note.001.line.005.state" "text"
        "note.001.line.005.text" "Hybrid threat behavior (approved 2026-09-27): full stealth means zero new damage-generated"
        "note.001.line.006.state" "text"
        "note.001.line.006.text" "threat, not a threat wipe or taunt cancellation; landing-time checks and DOT follow §3.2 `ai-behavior`."
        "note.001.source.file" "3_Classes.md"
        "note.001.source.start" "918"
        "note.001.source.end" "923"
    }
}

r_status_effect = element "status-effect" "Class" {
    tags "Class,Combat"
    properties {
        "id" "status-effect"
        "kind" "Class"
        "order" "925"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "3_Classes.md"
        "source.start" "925"
        "source.end" "964"
        "title" "status-effect"
        "heading.level" "3"
        "heading.slug" "status-effect"
        "section" "Combat"
        "note.001.kind" "paragraph"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "→ `instances/status-effects.json`: poison, burning, slow/frozen (blue tint), stun (stars),"
        "note.001.line.002.state" "text"
        "note.001.line.002.text" "knockdown, knockback, taunt (red tint), stealth (transparent), possessed `S`, mana-absorption `S`,"
        "note.001.line.003.state" "text"
        "note.001.line.003.text" "petrified `S`, dizzy (glider crash), drowning `S`, injured `X` (2012 devlog death debuff),"
        "note.001.line.004.state" "text"
        "note.001.line.004.text" "buffs: battle-fury, berserker-rage stacks, torrent stacks, hit-series, fire-spark, intuition,"
        "note.001.line.005.state" "text"
        "note.001.line.005.text" "elusiveness-window, elixir ×4, beverage-resistance ×3, circle-of-power, mana-shield `A`, bulwark `A`,"
        "note.001.line.006.state" "text"
        "note.001.line.006.text" "war-frenzy `A`, scouts-swiftness `A`, camouflage, ninjutsu, shadow-shooter clone."
        "note.001.source.file" "3_Classes.md"
        "note.001.source.start" "926"
        "note.001.source.end" "931"
        "note.002.kind" "paragraph"
        "note.002.line.001.state" "text"
        "note.002.line.001.text" "Hybrid (D23): creature hits on the player roll stun and knockback under"
        "note.002.line.002.state" "text"
        "note.002.line.002.text" "`design.defence.enemy-hit`; blocked or dodged hits roll neither."
        "note.002.source.file" "3_Classes.md"
        "note.002.source.start" "933"
        "note.002.source.end" "934"
        "note.003.kind" "paragraph"
        "note.003.line.001.state" "text"
        "note.003.line.001.text" "Hybrid poison (D26; narrow runtime repair authorized in walkthrough item 10, 2026-09-17):"
        "note.003.line.002.state" "text"
        "note.003.line.002.text" "scheduled poison damage is not prevented by dodge i-frames. Preserve poison's identity through"
        "note.003.line.003.state" "text"
        "note.003.line.003.text" "tick delivery, including when burns coexist. Ordinary burning/direct-hit dodge behavior is unchanged;"
        "note.003.line.004.state" "text"
        "note.003.line.004.text" "independent applications follow the combat DOT rules below."
        "note.003.source.file" "3_Classes.md"
        "note.003.source.start" "936"
        "note.003.source.end" "939"
        "note.004.kind" "paragraph"
        "note.004.line.001.state" "text"
        "note.004.line.001.text" "Hit-derived DOT's Resistance handling follows [stat (locator=stat)](3_Classes.dsl), item 4."
        "note.004.source.file" "3_Classes.md"
        "note.004.source.start" "941"
        "note.004.source.end" "941"
        "note.005.kind" "paragraph"
        "note.005.line.001.state" "text"
        "note.005.line.001.text" "**Hybrid combat DOT item 1 (owner approved, 2026-10-17):** each successful combat"
        "note.005.line.002.state" "text"
        "note.005.line.002.text" "hit-derived burning application creates its **own four-second burn**, without replacing or"
        "note.005.line.003.state" "text"
        "note.005.line.003.text" "refreshing earlier burns. Each application ticks every **0.5 seconds**, first at **0.5 seconds**"
        "note.005.line.004.state" "text"
        "note.005.line.004.text" "and last at **four seconds** after its application (eight ticks). Each tick retains D21's"
        "note.005.line.005.state" "text"
        "note.005.line.005.text" "**10% of the triggering hit** coefficient. Burns based on 100- and 50-damage hits therefore"
        "note.005.line.006.state" "text"
        "note.005.line.006.text" "deal **10 and 5 per tick**, respectively, while both remain active; a multi-hit volley may"
        "note.005.line.007.state" "text"
        "note.005.line.007.text" "leave several burns."
        "note.005.source.file" "3_Classes.md"
        "note.005.source.start" "943"
        "note.005.source.end" "949"
        "note.006.kind" "paragraph"
        "note.006.line.001.state" "text"
        "note.006.line.001.text" "**Hybrid combat DOT item 2 (owner approved, 2026-10-17):** every combat hit-derived poison"
        "note.006.line.002.state" "text"
        "note.006.line.002.text" "application has an **independent lifetime and schedule**. Dagger poison delivers its existing"
        "note.006.line.003.state" "text"
        "note.006.line.003.text" "five ticks at **one, two, three, four and five seconds after application**. New applications"
        "note.006.line.004.state" "text"
        "note.006.line.004.text" "neither refresh older stacks nor reset their next tick. Applications two seconds apart finish"
        "note.006.line.005.state" "text"
        "note.006.line.005.text" "at seconds **five and seven**, respectively. Preserve poison stacking, inherited hit damage/crit"
        "note.006.line.006.state" "text"
        "note.006.line.006.text" "and the existing dagger total of **5 × the hit over five seconds**."
        "note.006.source.file" "3_Classes.md"
        "note.006.source.start" "951"
        "note.006.source.end" "956"
        "note.007.kind" "paragraph"
        "note.007.line.001.state" "text"
        "note.007.line.001.text" "These rules select application lifetimes and scheduling, not new damage coefficients, Resistance"
        "note.007.line.002.state" "text"
        "note.007.line.002.text" "handling, dodge/status protections or aggro rules. Environmental hazards and additional DOT"
        "note.007.line.003.state" "text"
        "note.007.line.003.text" "buff timing are outside scope. The runtime retains each application's damage, source, remaining"
        "note.007.line.004.state" "text"
        "note.007.line.004.text" "lifetime and next tick independently, catching up due ticks only within its lifetime. Scoped"
        "note.007.line.005.state" "text"
        "note.007.line.005.text" "load-time checks require the selected burning/poison design rows and numeric values; this does"
        "note.007.line.006.state" "text"
        "note.007.line.006.text" "not implement the separately deferred Resistance or aggro rules."
        "note.007.source.file" "3_Classes.md"
        "note.007.source.start" "958"
        "note.007.source.end" "963"
    }
}

r_death = element "death" "Class" {
    tags "Class,Combat"
    properties {
        "id" "death"
        "kind" "Class"
        "order" "965"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "3_Classes.md"
        "source.start" "965"
        "source.end" "969"
        "title" "death"
        "heading.level" "3"
        "heading.slug" "death"
        "section" "Combat"
        "note.001.kind" "paragraph"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "No penalty in A or S (no gold/item/XP loss). A: respawn at nearest revival statue (never far), enemy"
        "note.001.line.002.state" "text"
        "note.001.line.002.text" "HP resets. S: only to an *activated* shrine of life; boss HP resets unless shrine is close."
        "note.001.line.003.state" "text"
        "note.001.line.003.text" "`X`: 2012 \"injured\" debuff (reduced max HP, band-aids, cured by eating)."
        "note.001.source.file" "3_Classes.md"
        "note.001.source.start" "966"
        "note.001.source.end" "968"
    }
}

