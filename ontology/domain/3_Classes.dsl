r_pet_food = element "pet-food" "Class" {
    tags "Class,Items"
    properties {
        "id" "pet-food"
        "kind" "Class"
        "order" "1120"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "3_Classes.md"
        "source.start" "1120"
        "source.end" "1132"
        "title" "pet-food"
        "heading.level" "3"
        "heading.slug" "pet-food"
        "section" "Items"
        "note.001.kind" "paragraph"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "Item type 20. `tames` identifies explicitly approved creature species by stable ID; each creature"
        "note.001.line.002.state" "text"
        "note.001.line.002.text" "still has at most one `tame-food`. Normally a food names one species and its numeric subtype"
        "note.001.line.003.state" "text"
        "note.001.line.003.text" "matches that species' known source entity ID, including post-alpha IDs (`c-food-id`)."
        "note.001.source.file" "3_Classes.md"
        "note.001.source.start" "1121"
        "note.001.source.end" "1123"
        "note.002.kind" "paragraph"
        "note.002.line.001.state" "text"
        "note.002.line.001.text" "**Shared-food exception (family item 9, approved 2026-09-27):** Bubble Gum names both `collie`"
        "note.002.line.002.state" "text"
        "note.002.line.002.text" "and `skeleton-dog`. It remains one food item, with subtype **19** anchored to Collie's source ID;"
        "note.002.line.003.state" "text"
        "note.002.line.003.text" "this neither assigns 19 to Skeleton Dog nor invents its unrecorded source ID. All other food"
        "note.002.line.004.state" "text"
        "note.002.line.004.text" "pairings and numeric identities remain unchanged; membership in `dogs` grants no bait pairing."
        "note.002.line.005.state" "text"
        "note.002.line.005.text" "One of each food carried at a time still applies, not one Bubble Gum per target species."
        "note.002.line.006.state" "text"
        "note.002.line.006.text" "Live `pet-food.tames`, model/loader and validator remain single-species; migration is deferred."
        "note.002.line.007.state" "text"
        "note.002.line.007.text" "→ `instances/pet-food.json` (58 obtainable + 5 cut `X`)."
        "note.002.source.file" "3_Classes.md"
        "note.002.source.start" "1125"
        "note.002.source.end" "1131"
    }
}

r_key_item = element "key-item" "Class" {
    tags "Class,Items"
    properties {
        "id" "key-item"
        "kind" "Class"
        "order" "1133"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "3_Classes.md"
        "source.start" "1133"
        "source.end" "1160"
        "title" "key-item"
        "heading.level" "3"
        "heading.slug" "key-item"
        "section" "Items"
        "note.001.kind" "paragraph"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "`S` land-bound \"special\" items (A: glider & boat were bought items in the special slot)."
        "note.001.line.002.state" "text"
        "note.001.line.002.text" "→ `instances/key-items.json`: hang-glider, boat, reins, climbing-spikes (movement, 4/land);"
        "note.001.line.003.state" "text"
        "note.001.line.003.text" "divine-harp, sky-whistle, spirit-bell (ticket, 3/land); treasure-spirit, eternal-ember,"
        "note.001.line.004.state" "text"
        "note.001.line.004.text" "iron-lamp (`A` item / `S` innate light ability; [lamp control (locator=lamp)](controls.dsl)), dungeon keys (gold/silver/copper/boss keys), flute"
        "note.001.line.005.state" "text"
        "note.001.line.005.text" "(auto-owned, activates shrines), alpha special-accessory data `X` (key, jewel case, medicine,"
        "note.001.line.006.state" "text"
        "note.001.line.006.text" "antivenom, band-aid, crutch, bandage, salve)."
        "note.001.source.file" "3_Classes.md"
        "note.001.source.start" "1134"
        "note.001.source.end" "1139"
        "note.002.kind" "paragraph"
        "note.002.line.001.state" "text"
        "note.002.line.001.text" "Hybrid key items work globally once acquired (`c-gear-global`); the land-bound S records above"
        "note.002.line.002.state" "text"
        "note.002.line.002.text" "are historical reference. Reins are required alongside training and a rideable tamed pet"
        "note.002.line.003.state" "text"
        "note.002.line.003.text" "(`pet`, traversal item 1), not an alternative to either. No Reins slot or new acquisition route"
        "note.002.line.004.state" "text"
        "note.002.line.004.text" "is approved. Hybrid gliding/sailing need the respective vendor-bought, equipped Hang Glider/Boat"
        "note.002.line.005.state" "text"
        "note.002.line.005.text" "plus training (`skill-tree`, traversal items 2–3); A/S acquisition records do not override these rules."
        "note.002.source.file" "3_Classes.md"
        "note.002.source.start" "1141"
        "note.002.source.end" "1145"
        "note.003.kind" "paragraph"
        "note.003.line.001.state" "text"
        "note.003.line.001.text" "**Hybrid traversal item 4 (owner corrected, 2026-09-28):** globally acquired **Climbing Spikes"
        "note.003.line.002.state" "text"
        "note.003.line.002.text" "reduce climbing stamina consumption by 75%**, rather than eliminating it. Basic climbing and"
        "note.003.line.003.state" "text"
        "note.003.line.003.text" "Climbing points' drain reduction follow `skill-tree`. The infinite-climbing/no-stamina S behavior"
        "note.003.line.004.state" "text"
        "note.003.line.004.text" "in `key-items.json#climbing-spikes` and `abilities.json#climb` is reference only, not a hybrid"
        "note.003.line.005.state" "text"
        "note.003.line.005.text" "target. Live-data migration and runtime enforcement remain deferred."
        "note.003.source.file" "3_Classes.md"
        "note.003.source.start" "1147"
        "note.003.source.end" "1151"
        "note.004.kind" "paragraph"
        "note.004.line.001.state" "text"
        "note.004.line.001.text" "**Hybrid traversal item 5 (owner approved separately, 2026-09-28):** apply Spikes **after the"
        "note.004.line.002.state" "text"
        "note.004.line.002.text" "Climbing skill reduction**: `climbing cost with Spikes = skill-adjusted climbing cost × 0.25`."
        "note.004.line.003.state" "text"
        "note.004.line.003.text" "Do not add 75 percentage points to the skill reduction. Illustrative only, not balance defaults:"
        "note.004.line.004.state" "text"
        "note.004.line.004.text" "if skill reduces a climb's cost from 10 stamina to 8, Spikes reduce 8 to **2**, not 0.5."
        "note.004.line.005.state" "text"
        "note.004.line.005.text" "Climbing points retain their drain-reduction benefit alongside Spikes; Spikes alone do not turn"
        "note.004.line.006.state" "text"
        "note.004.line.006.text" "a positive skill-adjusted cost into zero. This defines neither the skill reduction curve/floor"
        "note.004.line.007.state" "text"
        "note.004.line.007.text" "nor artifact-combination semantics."
        "note.004.source.file" "3_Classes.md"
        "note.004.source.start" "1153"
        "note.004.source.end" "1159"
    }
}

r_artifact = element "artifact" "Class" {
    tags "Class,Items"
    properties {
        "id" "artifact"
        "kind" "Class"
        "order" "1161"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "3_Classes.md"
        "source.start" "1161"
        "source.end" "1223"
        "title" "artifact"
        "heading.level" "3"
        "heading.slug" "artifact"
        "section" "Items"
        "note.001.kind" "paragraph"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "Relic collectible from `S`; permanent and works everywhere; hybrid count is 1–3 per land (D11)."
        "note.001.line.002.state" "text"
        "note.001.line.002.text" "Named \"<Ring|Stone|…> of <Name>\", bound to a realm; found at dungeon ends, vaults, sewers,"
        "note.001.line.003.state" "text"
        "note.001.line.003.text" "sky islands and some mission chests. **S reference only:** each relic granted +1 level;"
        "note.001.line.004.state" "text"
        "note.001.line.004.text" "riding/climbing/gliding bonuses were reportedly non-functional in 1.0 (functional in hybrid, D6)."
        "note.001.line.005.state" "text"
        "note.001.line.005.text" "Static entity id 46 \"Artifact\" exists in alpha data `X`."
        "note.001.source.file" "3_Classes.md"
        "note.001.source.start" "1162"
        "note.001.source.end" "1166"
        "note.002.kind" "paragraph"
        "note.002.line.001.state" "text"
        "note.002.line.001.text" "Hybrid artifact-source claims are personal per saved world (`save-data`, persistence item 5)."
        "note.002.source.file" "3_Classes.md"
        "note.002.source.start" "1168"
        "note.002.source.end" "1168"
        "note.003.kind" "paragraph"
        "note.003.line.001.state" "text"
        "note.003.line.001.text" "**Hybrid artifacts item 1 (owner corrected, 2026-09-28):** count contributors **separately"
        "note.003.line.002.state" "text"
        "note.003.line.002.text" "for each traversal stat**, not globally across traversal kinds. All collected artifacts that"
        "note.003.line.003.state" "text"
        "note.003.line.003.text" "contribute to the same stat share its **current contribution equally**; acquisition order does"
        "note.003.line.004.state" "text"
        "note.003.line.004.text" "not preserve earlier, larger grants. Collecting a different traversal kind does not reduce"
        "note.003.line.005.state" "text"
        "note.003.line.005.text" "this stat's contributors' rate. The initial exponential equal-share examples are superseded"
        "note.003.line.006.state" "text"
        "note.003.line.006.text" "by item 5's logarithmic total below."
        "note.003.line.007.state" "text"
        "note.003.line.007.text" "This artifact-count mechanism does not extend to other item kinds. Existing level/rarity"
        "note.003.line.008.state" "text"
        "note.003.line.008.text" "curves, power gates and other non-artifact rules remain unchanged; inspect and ask before"
        "note.003.line.009.state" "text"
        "note.003.line.009.text" "changing any existing reduction mechanism."
        "note.003.source.file" "3_Classes.md"
        "note.003.source.start" "1170"
        "note.003.source.end" "1178"
        "note.004.kind" "paragraph"
        "note.004.line.001.state" "text"
        "note.004.line.001.text" "**Hybrid artifacts item 2 (owner approved, 2026-09-28):** contributions to an affected stat"
        "note.004.line.002.state" "text"
        "note.004.line.002.text" "**add**, never multiply or compound artifact-on-artifact. Let `B(x)` be the **fractional total"
        "note.004.line.003.state" "text"
        "note.004.line.003.text" "bonus** from its `x` contributing artifacts. For `x > 0`, each artifact's equal current share"
        "note.004.line.004.state" "text"
        "note.004.line.004.text" "is `B(x) / x`; their sum is `B(x)`, not `x × B(x)`. The total curve is recorded separately in item 5."
        "note.004.source.file" "3_Classes.md"
        "note.004.source.start" "1180"
        "note.004.source.end" "1183"
        "note.005.kind" "paragraph"
        "note.005.line.001.state" "text"
        "note.005.line.001.text" "**Hybrid artifacts item 3 (owner approved, 2026-09-28):** first compute the affected stat"
        "note.005.line.002.state" "text"
        "note.005.line.002.text" "normally **without artifacts**, including applicable level, equipment, skills and buffs."
        "note.005.line.003.state" "text"
        "note.005.line.003.text" "Then `stat with artifacts = current artifact-free stat × (1 + B(x))`. Recalculate when"
        "note.005.line.004.state" "text"
        "note.005.line.004.text" "ordinary stat inputs change; never snapshot the stat at pickup. This adds no stat target"
        "note.005.line.005.state" "text"
        "note.005.line.005.text" "or unrelated effect."
        "note.005.source.file" "3_Classes.md"
        "note.005.source.start" "1185"
        "note.005.source.end" "1189"
        "note.006.kind" "paragraph"
        "note.006.line.001.state" "text"
        "note.006.line.001.text" "**Hybrid artifacts item 4 (owner approved after clarification, 2026-09-28):** every artifact"
        "note.006.line.002.state" "text"
        "note.006.line.002.text" "still grants **exactly one** of the seven existing traversal kinds (`climb-speed`, `swim-speed`,"
        "note.006.line.003.state" "text"
        "note.006.line.003.text" "`diving-skill`, `ride-speed`, `glide-speed`, `sail-speed`, `light-radius`) **plus attack and"
        "note.006.line.004.state" "text"
        "note.006.line.004.text" "maximum HP**. Attack and maximum HP use the **same recalculation** as traversal, each counting"
        "note.006.line.005.state" "text"
        "note.006.line.005.text" "**all collected artifacts**, because every artifact grants both. Each traversal stat counts"
        "note.006.line.006.state" "text"
        "note.006.line.006.text" "only its matching artifacts, separately. Artifacts grant no character levels and bypass no"
        "note.006.line.007.state" "text"
        "note.006.line.007.text" "existing traversal training/item gates; no equipment slot is added."
        "note.006.source.file" "3_Classes.md"
        "note.006.source.start" "1191"
        "note.006.source.end" "1197"
        "note.007.kind" "paragraph"
        "note.007.line.001.state" "text"
        "note.007.line.001.text" "**Hybrid artifacts item 5 (owner approved with initial z=0.1, 2026-09-28):** for the affected"
        "note.007.line.002.state" "text"
        "note.007.line.002.text" "stat's **nonnegative integer count** `x`, the fractional total bonus is:"
        "note.007.source.file" "3_Classes.md"
        "note.007.source.start" "1199"
        "note.007.source.end" "1200"
        "note.008.kind" "paragraph"
        "note.008.line.001.state" "text"
        "note.008.line.001.text" "`B(x) = 0.05 × ln(1 + z × x) / ln(1 + z)`, with `z > 0`; **initial z = 0.1**."
        "note.008.source.file" "3_Classes.md"
        "note.008.source.start" "1202"
        "note.008.source.end" "1202"
        "note.009.kind" "paragraph"
        "note.009.line.001.state" "text"
        "note.009.line.001.text" "`B(0) = 0` (no stat change), `B(1) = 0.05` (5%). Totals strictly increase as more contributing"
        "note.009.line.002.state" "text"
        "note.009.line.002.text" "artifacts are collected, with diminishing marginal gains and **no hard cap**. Equal current"
        "note.009.line.003.state" "text"
        "note.009.line.003.text" "shares follow item 2, and the current-stat multiplier follows item 3. Larger positive `z`"
        "note.009.line.004.state" "text"
        "note.009.line.004.text" "gives stronger diminishing returns; `z` is adjustable for balance. The normalized logarithm's"
        "note.009.line.005.state" "text"
        "note.009.line.005.text" "base cancels, so there is **no separate y tuning knob**."
        "note.009.line.006.state" "text"
        "note.009.line.006.text" "Rounded total examples at z=0.1: two contributors give **9.565%**, three"
        "note.009.line.007.state" "text"
        "note.009.line.007.text" "**13.764%**; these are totals, not individual grants."
        "note.009.source.file" "3_Classes.md"
        "note.009.source.start" "1204"
        "note.009.source.end" "1210"
        "note.010.kind" "paragraph"
        "note.010.line.001.state" "text"
        "note.010.line.001.text" "**Hybrid artifacts item 6 (owner approved, 2026-09-28):** **remove the old per-artifact 1%"
        "note.010.line.002.state" "text"
        "note.010.line.002.text" "floor**. The approved logarithmic curve replaces D6's ×0.9 accumulation/decay rule and its"
        "note.010.line.003.state" "text"
        "note.010.line.003.text" "floor; there is no hidden clamp, minimum per-artifact contribution or minimum marginal gain."
        "note.010.line.004.state" "text"
        "note.010.line.004.text" "The first artifact remains 5%."
        "note.010.source.file" "3_Classes.md"
        "note.010.source.start" "1212"
        "note.010.source.end" "1215"
        "note.011.kind" "paragraph"
        "note.011.line.001.state" "text"
        "note.011.line.001.text" "Documentation only: live `generators.json#design.artifact` still stores D6's `first: 0.05`,"
        "note.011.line.002.state" "text"
        "note.011.line.002.text" "`decay: 0.9`, `floor: 0.01`; `key-items.json#artifact` still mixes historical S levels with"
        "note.011.line.003.state" "text"
        "note.011.line.003.text" "old D6 accumulation text, and `rulesets.json#ruleset-hybrid._rule` still says D6 bonuses are"
        "note.011.line.004.state" "text"
        "note.011.line.004.text" "unchanged. These do not override the current rules above. Direct replacement of obsolete checked-in values,"
        "note.011.line.005.state" "text"
        "note.011.line.005.text" "model/loader/validator support and generated-artifact/runtime enforcement remain deferred and"
        "note.011.line.006.state" "text"
        "note.011.line.006.text" "unauthorized; no legacy format or migration support is required (§0)."
        "note.011.source.file" "3_Classes.md"
        "note.011.source.start" "1217"
        "note.011.source.end" "1222"
    }
}

