r_spirit_cube = element "spirit-cube" "Class" {
    tags "Class,Items"
    properties {
        "id" "spirit-cube"
        "kind" "Class"
        "order" "1102"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "3_Classes.md"
        "source.start" "1102"
        "source.end" "1111"
        "title" "spirit-cube"
        "heading.level" "3"
        "heading.slug" "spirit-cube"
        "section" "Items"
        "note.001.kind" "paragraph"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "`A` boss drop: one per eligible non-mission boss kill, always the same type/level per boss."
        "note.001.line.002.state" "text"
        "note.001.line.002.text" "Fire (+fire damage), wind (+attack & move speed per combo hit), ice (slows target, blue), unholy"
        "note.001.line.003.state" "text"
        "note.001.line.003.text" "(life steal on specials scaling with combo). Level must satisfy"
        "note.001.line.004.state" "text"
        "note.001.line.004.text" "`weapon-level − 10 ≤ cube-level ≤ weapon-level`."
        "note.001.source.file" "3_Classes.md"
        "note.001.source.start" "1103"
        "note.001.source.end" "1106"
        "note.002.kind" "paragraph"
        "note.002.line.001.state" "text"
        "note.002.line.001.text" "Hybrid retains the recorded alpha exception (reconciliation item 7, approved 2026-09-15):"
        "note.002.line.002.state" "text"
        "note.002.line.002.text" "mission bosses, including Saurians, drop no spirit cube; their normal mission rewards are"
        "note.002.line.003.state" "text"
        "note.002.line.003.text" "unchanged. Sources: `creatures.json#saurian`, `mission-types.json#alpha.boss-kill`."
        "note.002.source.file" "3_Classes.md"
        "note.002.source.start" "1108"
        "note.002.source.end" "1110"
    }
}

