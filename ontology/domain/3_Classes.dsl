r_book_of_crafting = element "book-of-crafting" "Class" {
    tags "Class,Items"
    properties {
        "id" "book-of-crafting"
        "kind" "Class"
        "order" "1083"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "3_Classes.md"
        "source.start" "1083"
        "source.end" "1096"
        "title" "book-of-crafting"
        "heading.level" "3"
        "heading.slug" "book-of-crafting"
        "section" "Items"
        "note.001.kind" "paragraph"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "`S` 4 per land (uncommon/rare/epic/legendary), 3–4 recipes each, from hammer-icon missions; only"
        "note.001.line.002.state" "text"
        "note.001.line.002.text" "recipe source; recipes land-scoped. These are historical S rules, not hybrid exclusivity or scope."
        "note.001.source.file" "3_Classes.md"
        "note.001.source.start" "1084"
        "note.001.source.end" "1085"
        "note.002.kind" "paragraph"
        "note.002.line.001.state" "text"
        "note.002.line.001.text" "**Hybrid books/formulas item 1 (owner approved, 2026-09-28):** books and formulas both remain"
        "note.002.line.002.state" "text"
        "note.002.line.002.text" "in the hybrid game. Recipes learned from books are **permanent for that character across lands"
        "note.002.line.003.state" "text"
        "note.002.line.003.text" "and sessions**; moving to another land never requires relearning them. Persistence item 1"
        "note.002.line.004.state" "text"
        "note.002.line.004.text" "(§3.7) extends character recipe knowledge across worlds, without shared-account knowledge. Crafting materials and"
        "note.002.line.005.state" "text"
        "note.002.line.005.text" "equipment strength are unchanged. Shared knowledge/duplicates follow `recipe` item 2;"
        "note.002.line.006.state" "text"
        "note.002.line.006.text" "immediate recording and power-locked crafting follow `power-gate` item 3."
        "note.002.line.007.state" "text"
        "note.002.line.007.text" "Live-data migration and implementation remain deferred."
        "note.002.source.file" "3_Classes.md"
        "note.002.source.start" "1087"
        "note.002.source.end" "1093"
        "note.003.kind" "paragraph"
        "note.003.line.001.state" "text"
        "note.003.line.001.text" "Hybrid one-time book-source claims are personal per saved world (`save-data`, persistence item 5)."
        "note.003.source.file" "3_Classes.md"
        "note.003.source.start" "1095"
        "note.003.source.end" "1095"
    }
}

