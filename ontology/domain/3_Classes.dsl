r_multiplayer_mode = element "multiplayer-mode" "Class" {
    tags "Class,Meta"
    properties {
        "id" "multiplayer-mode"
        "kind" "Class"
        "order" "1386"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "3_Classes.md"
        "source.start" "1386"
        "source.end" "1412"
        "title" "multiplayer-mode"
        "heading.level" "3"
        "heading.slug" "multiplayer-mode"
        "section" "Meta"
        "note.001.kind" "paragraph"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "Hybrid (D5/D7): dedicated server, alpha style; max players configurable, default 4."
        "note.001.line.002.state" "text"
        "note.001.line.002.text" "Players join by IP address or DNS name; the world-generation seed is configurable in server configuration."
        "note.001.line.003.state" "text"
        "note.001.line.003.text" "Shared-clock inn sleep consent/payment follows `game-clock` item 4 (approved 2026-09-27)."
        "note.001.line.004.state" "text"
        "note.001.line.004.text" "Hybrid (D11): PvP is a server-wide `server.cfg` flag `pvp`, default off; `/pvp` is dropped."
        "note.001.line.005.state" "text"
        "note.001.line.005.text" "A: dedicated `Server.exe`, TCP 12345, seed from `server.cfg`, connect by IP/DNS, 4 players (alpha-era wiki said 10),"
        "note.001.line.006.state" "text"
        "note.001.line.006.text" "client-authoritative, chat + `/connect /disconnect /name /namepet /pvp`, item trading by drop."
        "note.001.line.007.state" "text"
        "note.001.line.007.text" "S: Steam-friends P2P (J), shared seed, keep own position, meet via free flights to friends,"
        "note.001.line.008.state" "text"
        "note.001.line.008.text" "artifacts lootable by all, ember per participant, other players' level on highlight, emotes"
        "note.001.line.009.state" "text"
        "note.001.line.009.text" "`/sit /wave /dance /pet`; no PvP, no trading UI, no dedicated server."
        "note.001.source.file" "3_Classes.md"
        "note.001.source.start" "1387"
        "note.001.source.end" "1395"
        "note.002.kind" "paragraph"
        "note.002.line.001.state" "text"
        "note.002.line.001.text" "**Hybrid persistence item 6 (owner approved, 2026-09-28):** clients **request actions**;"
        "note.002.line.002.state" "text"
        "note.002.line.002.text" "the server validates movement, attacks, costs, damage, loot, purchases and progression against"
        "note.002.line.003.state" "text"
        "note.002.line.003.text" "the rules and decides gameplay outcomes. A client cannot simply announce extra money or a"
        "note.002.line.004.state" "text"
        "note.002.line.004.text" "successful hit. Client predictions may need correction to authoritative outcomes."
        "note.002.line.005.state" "text"
        "note.002.line.005.text" "Alpha's client-authoritative protocol and `generators.json#network-alpha` are historical"
        "note.002.line.006.state" "text"
        "note.002.line.006.text" "reference, not hybrid authority. This chooses no transport/protocol, anti-cheat numeric defaults"
        "note.002.line.007.state" "text"
        "note.002.line.007.text" "or central trust service. Networking and enforcement remain deferred and unauthorized."
        "note.002.source.file" "3_Classes.md"
        "note.002.source.start" "1397"
        "note.002.source.end" "1403"
        "note.003.kind" "paragraph"
        "note.003.line.001.state" "text"
        "note.003.line.001.text" "**Hybrid persistence item 7 (owner approved, 2026-09-28; depends on item 1):** accept"
        "note.003.line.002.state" "text"
        "note.003.line.002.text" "**rule-valid portable characters as trusted-co-op imports**, without requiring a central"
        "note.003.line.003.state" "text"
        "note.003.line.003.text" "progression service. Reject an invalid import with an explanation and **leave the original save"
        "note.003.line.004.state" "text"
        "note.003.line.004.text" "untouched**; never silently strip items or levels. A legally shaped edited save can still pass:"
        "note.003.line.005.state" "text"
        "note.003.line.005.text" "item 6's authority over gameplay after joining cannot prove where imported progression was earned"
        "note.003.line.006.state" "text"
        "note.003.line.006.text" "and does not make portable progression cheat-proof. No provenance proof, closed economy or"
        "note.003.line.007.state" "text"
        "note.003.line.007.text" "global concurrency guarantee is promised. Import validation/enforcement remains deferred."
        "note.003.source.file" "3_Classes.md"
        "note.003.source.start" "1405"
        "note.003.source.end" "1411"
    }
}

r_control_action = element "control-action" "Class" {
