// Authoritative domain records. source.* coordinates refer only to baseline 175e0c59b6a05ead62d29bd851085cd5a3818378.
r_c_controller_profiles = element "c-controller-profiles" "SectionNote" {
    tags "SectionNote,Overview"
    properties {
        "id" "c-controller-profiles"
        "kind" "SectionNote"
        "order" "1"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "controller-profiles.md"
        "source.start" "1"
        "source.end" "7"
        "title" "Controller profiles"
        "heading.level" "1"
        "heading.slug" "controller-profiles"
        "section" "Overview"
        "note.001.kind" "paragraph"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "Profiles bind only the [canonical controls](controls.dsl). Physical choices, aliases, context"
        "note.001.line.002.state" "text"
        "note.001.line.002.text" "multiplexing and adapter names belong here, never in action meanings. Status distinguishes a"
        "note.001.line.003.state" "text"
        "note.001.line.003.text" "binding in data from a working feature. No general controller resolver is implemented; the Android first-slice executable subset is in"
        "note.001.line.004.state" "text"
        "note.001.line.004.text" "[`controller-profiles.json#android`](../instances/controller-profiles.json)."
        "note.001.source.file" "controller-profiles.md"
        "note.001.source.start" "3"
        "note.001.source.end" "6"
    }
}

