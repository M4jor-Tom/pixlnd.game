        "source.status" "historical baseline coordinates"
        "source.file" "controller-profiles.md"
        "source.start" "189"
        "source.end" "197"
        "title" "Device switching and customization in this slice"
        "heading.level" "3"
        "heading.slug" "device-switching-and-customization-in-this-slice"
        "section" "Overview"
        "note.001.kind" "paragraph"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "Android gameplay initially uses the touch profile only; desktop keyboard/mouse is unchanged."
        "note.001.line.002.state" "text"
        "note.001.line.002.text" "External keyboard/mouse gameplay on Android, gamepad switching, automatic device switching,"
        "note.001.line.003.state" "text"
        "note.001.line.003.text" "rebinding, layout editing and saved control preferences are deferred in this slice, not"
        "note.001.line.004.state" "text"
        "note.001.line.004.text" "permanently excluded or assigned future defaults. Android labels describe touch actions,"
        "note.001.line.005.state" "text"
        "note.001.line.005.text" "not keyboard instructions such as “B closes”."
        "note.001.source.file" "controller-profiles.md"
        "note.001.source.start" "191"
        "note.001.source.end" "195"
        "note.002.kind" "paragraph"
        "note.002.line.001.state" "text"
        "note.002.line.001.text" "<a id=\"android-back\"></a>"
        "note.002.anchor.001" "android-back"
        "note.002.source.file" "controller-profiles.md"
        "note.002.source.start" "197"
        "note.002.source.end" "197"
    }
}

r_c_android_back_when_no_panel_is_open = element "c-android-back-when-no-panel-is-open" "SectionNote" {
    tags "SectionNote,Overview"
    properties {
        "id" "c-android-back-when-no-panel-is-open"
        "kind" "SectionNote"
        "order" "198"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "controller-profiles.md"
        "source.start" "198"
        "source.end" "204"
        "title" "Android Back when no panel is open"
        "heading.level" "3"
        "heading.slug" "android-back-when-no-panel-is-open"
        "section" "Overview"
        "note.001.kind" "paragraph"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "With a [supported panel (locator=android-panels)](controller-profiles.dsl) open, Back closes it and consumes the input."
        "note.001.line.002.state" "text"
        "note.001.line.002.text" "Otherwise consume Back without attacking, quitting or opening a new menu. Players can"
        "note.001.line.003.state" "text"
        "note.001.line.003.text" "background the app through Android system navigation; the [touch-cleanup rule (locator=android-interruption)](controller-profiles.dsl)"
        "note.001.line.004.state" "text"
        "note.001.line.004.text" "applies. This adds no pause, background simulation, save policy or system-menu implementation;"
        "note.001.line.005.state" "text"
        "note.001.line.005.text" "future menus retain their own design requirements."
        "note.001.source.file" "controller-profiles.md"
        "note.001.source.start" "200"
        "note.001.source.end" "204"
    }
}
