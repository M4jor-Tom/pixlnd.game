// Authoritative domain records. source.* coordinates refer only to baseline 175e0c59b6a05ead62d29bd851085cd5a3818378.
r_0_0_conventions = element "0-0-conventions" "SectionNote" {
    tags "SectionNote,Overview"
    properties {
        "id" "0-0-conventions"
        "kind" "SectionNote"
        "order" "1"
        "source.commit" "175e0c59b6a05ead62d29bd851085cd5a3818378"
        "source.status" "historical baseline coordinates"
        "source.file" "0_Conventions.md"
        "source.start" "1"
        "source.end" "24"
        "title" "0. Conventions"
        "heading.level" "2"
        "heading.slug" "0-conventions"
        "section" "Overview"
        "note.001.kind" "list"
        "note.001.line.001.state" "text"
        "note.001.line.001.text" "- Every class, relation, generator and instance has a **stable kebab-case ID**. IDs never change"
        "note.001.line.002.state" "text"
        "note.001.line.002.text" "  once referenced; rename the `name`, not the `id`."
        "note.001.line.003.state" "text"
        "note.001.line.003.text" "- **Version tags** mark where a fact comes from, not pixlnd availability or implementation"
        "note.001.line.004.state" "text"
        "note.001.line.004.text" "  status. A feature may exist in several source versions; hybrid scope follows §1 and approvals."
        "note.001.line.005.state" "text"
        "note.001.line.005.text" "  - `A`  Alpha 0.1.0 / 0.1.1 (July 2013)"
        "note.001.line.006.state" "text"
        "note.001.line.006.text" "  - `S`  Steam 0.9.x beta → 1.0.0-1 (Sept 23 – Oct 1 2019)"
        "note.001.line.007.state" "text"
        "note.001.line.007.text" "  - `Ω`  Cube World Omega (announced 2023-05-25, unreleased; only announced facts)"
        "note.001.line.008.state" "text"
        "note.001.line.008.text" "  - `X`  present in shipped data / devlog but cut, unused or never functional"
        "note.001.line.009.state" "text"
        "note.001.line.009.text" "- `?` after a source value marks uncertainty, including qualified version annotations such as `S?` / `A?` (§5 Validation-contract mapping item 3); §7 separates active hybrid questions from reference-only research gaps. In type notation (`int?`, `ref?`), it instead means nullable/optional, not an unanswered design question."
        "note.001.line.010.state" "text"
        "note.001.line.010.text" "- Properties are split **intrinsic** (belong to the thing) vs **extrinsic** (references to other IDs)."
        "note.001.line.011.state" "text"
        "note.001.line.011.text" "- Runtime-generated content (terrain, dungeons, names, loot rolls, bosses) is **not** enumerated;"
        "note.001.line.012.state" "text"
        "note.001.line.012.text" "  its **generator** is a class (§6) and its config lives in `instances/generators.json`."
        "note.001.line.013.state" "text"
        "note.001.line.013.text" "- Numeric formulas are written in plain infix. `lvl` = character level, `n` = item level."
        "note.001.source.file" "0_Conventions.md"
        "note.001.source.start" "3"
        "note.001.source.end" "15"
        "note.002.kind" "paragraph"
        "note.002.line.001.state" "text"
        "note.002.line.001.text" "**Undeployed-game clarification (owner, 2026-09-28):** no player data exists to migrate."
        "note.002.line.002.state" "text"
        "note.002.line.002.text" "Require current approved definitions directly; obsolete checked-in values need direct replacement"
        "note.002.line.003.state" "text"
        "note.002.line.003.text" "when separately authorized, not save/config migrators, legacy-read fallbacks or compatibility"
        "note.002.line.004.state" "text"
        "note.002.line.004.text" "paths. Older “migration” deferrals in this document mean data correction/enforcement debt only,"
        "note.002.line.005.state" "text"
        "note.002.line.005.text" "not a migration plan. Stable source IDs and previously approved names remain unchanged."
        "note.002.source.file" "0_Conventions.md"
        "note.002.source.start" "17"
        "note.002.source.end" "21"
    }
}
