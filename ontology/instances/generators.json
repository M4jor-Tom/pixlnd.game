{
  "$schema": "generator-config",
  "_doc": "Configs and invariants for §6 generators. Numbers are reverse-engineered facts unless marked design.",
  "world-scales": {
    "block-native-units": 65536,
    "position-type": "int64 (16.16 fixed per axis)",
    "full-mask": "0x0000FFFFFFFFFFFF",
    "alpha": {"zone-blocks": 256, "region-zones": 64, "region-blocks": 16384, "regions-per-axis": 1024, "world-blocks-per-axis": 16777216, "mission-cells-per-region": [8, 8], "mission-scale": "region/8", "region-struct-bytes": 88104, "zone-struct-bytes": 200, "spawn-struct-bytes": 4336},
    "steam": {"zone-blocks": 64, "map-chunk-blocks": 20, "zone-fields": 4096, "field": "base_z + vector<Block>", "block-bytes": 6, "coords-typical-spawn": "±5,000,000 from origin", "origin-poi": "wollays-house"},
    "generation-neighbourhood": {"region-data": "3x3 around player", "region-seeds": "7x7"},
    "server-chunk-retire-s": 15,
    "invariants": ["same seed → same world", "no borders (finite 1024² regions)", "terrain generated on the fly, no precompute"]
  },
  "seed": {"alpha-default": 26879, "alpha-source": "server.cfg / world creation UI", "steam": "single fixed shared seed, random spawn"},
  "time": {"max-time-ms": 86400000, "normal-speed": 10.0, "sleep-speed": 100.0, "day-real-minutes": 144, "inn-hours": [18, 6], "inn-target": 7, "reset-hour": 0},
  "climate": {"fields": ["temperature", "humidity"], "bands": "see landscapes.json climate; devlog: high temp + high humidity → jungle", "hud": true},
  "land": {"alpha-level": "replaced (F4): party-level band + per-land danger tier → design.enemy-level", "alpha-rarity": "0-4 rare zones (?)", "steam-tiers": ["white", "green", "blue", "purple", "yellow"], "border": "dotted map line, no wall", "equal-size": true, "steam-per-land": {"gnomes": 4, "books": 4, "movement-items": 4, "ticket-items": 3, "key-items-max": 9, "towers-max": 5, "circles": "≥1", "artifacts": "design.artifacts-per-land", "settlements": "≥1"}, "alpha-per-land": {"settlements": 1, "mission-cells": 64}},
  "terrain": {"block-palette": "block-types.json", "features": "terrain-features.json", "water-level": "ours (F6), tuned in engine", "noise-params": "unknown; alpha generator exists only as x86 code wrapped by cuwo tgen", "roads": "auto tunnels through mountains, bridges over canyons", "caves": "type 18 (S)", "rivers": "with waterfalls; lava/toxic variants"},
  "coarse-map-omega": {"places": ["streets", "buildings", "rivers", "bridges", "trees", "caves", "fields", "windmills", "watchtowers", "walls", "fences", "street lights"], "then": "voxel detail on the fly", "planned-use": ["NPC navigation between distant places", "quest design"]},
  "settlement": {"alpha-count": 1, "steam-count": "several", "districts-alpha": ["trade", "crafting", "adventurer", "portal", "palace"], "buildings-procedural": ["rooms", "sizes", "roofs"], "style-by-landscape": "buildings.json#settlement-styles", "inn": {"A": "several", "S": 1}},
  "dungeon": {"alpha-layout": "linear + dead end", "steam-layout": "room gauntlet, rising tiers", "group-size": [2, 4], "mob-tier": "above surface", "traps-alpha": ["spike"], "traps-data-x": ["fire", "stomp"], "boss": {"A": 1, "S": "several"}, "artifact-s": "castles always", "size-cap-s": "0.9.3-0"},
  "spawns": {"group-sizes": "creatures.json group", "hostility": "creatures.json h", "humanoid-class": "any of 4 classes + spec", "alpha-multipliers": ["+1", "+2", "+3", "+4"], "farm-animals": "white, never aggressive", "night-lanterns": true, "reset": "midnight", "ocean-s-bug": "nearly empty"},
  "boss": {"chance": "low, any species", "traits": ["named", "enlarged (double-scale flag)", "tier-coloured name", "1-2 random special moves", "breaks terrain", "guards"], "special-pool": ["ground stomp", "fire missiles", "summon zombies", "summon weaker copies / clone", "slowing lava trap", "channelled explosion", "charge", "cyclone", "earthquake", "boulder throw", "doppelganger"], "alpha-size-scaling": "1 at lvl 1 → full at lvl 10", "alpha-spirit-drop": "fixed type+level per boss", "steam-loot": "+1 tier", "coins-s": 20, "arena-waves": [["white","green"],["white","green"],["green","blue"],["blue","purple"],["purple","yellow"]]},
  "names": {"land": "<Name> Plains|Hills|Mountains|Village|City|Road|Forest", "dungeon": "dungeon-types.json naming", "realm": "factions.json#realm-name-examples", "item": "affixes.json", "quarter": ["Trade Quarter", "Crafting Quarter", "Class Quarter", "Pet Quarter", "Portal", "Palace"], "uniqueness": false, "examples": ["Coria Plains", "Lanno Plains", "Sanion Hills", "Marnis Mountains", "Arris City", "Akar Village", "Caion Road", "Temple of Arno", "Tririon City", "Duragar Forest", "Vardara Forest"]},
  "item": {"roll": "((attributes<<16)+modifier) % 21", "rarity-range": [0, 4], "mythical-bug": false, "stat-curves": "stats.json#alpha-item-stat-formulas", "cubes-max": {"1h": 16, "2h": 32}, "plus-chance-s": "rare roll; ~1-2 per cleared land", "name-rule": "epic/legendary named"},
  "loot": "economy.json#loot",
  "realm": {"kinds": ["kingdom", "realm", "cult", "tribe"], "leader-fields": ["name", "trait", "birth-year", "hometown", "tomb"], "capital-fields": ["name", "founding-year", "destruction-date?"], "lore-per-site-pct": 10, "reveal-at": 100},
  "npc-appearance": {"asset-counts": "races.json", "hair-rgb": "free", "omega": "fully procedural + expressions"},
  "schedule": {"stops": ["home", "park", "shops", "inn"], "sleep": "night", "campsite-rest": true, "lantern-night": true},
  "key-items-s": {"rule": "spawn only if lock type exists (harp→divine door, bell→crypt gate, whistle→bird statue, boat→water)"},
  "level-formulas-alpha": "stats.json#alpha-character-formulas",
  "design": {
    "_doc": "Owner-designed tunables (D6/F4, 2026-09-07). Sources never had these; engine reads them from here; tune in play.",
    "enemy-level": {"rule": "creature level rolled in band [min-party-level - below, max-party-level + above] (solo: own level); each land rolls a danger-tier at generation that fixes where in the band it sits", "below": 3, "above": 5, "danger-tiers": {"safe": 0.0, "normal": 0.5, "dangerous": 1.0}, "tier-weights": {"safe": 0.25, "normal": 0.5, "dangerous": 0.25}, "config": "solo settings / server.cfg"},
    "skill-point": {"effect-per-point": 0.05, "cooldown-per-point": 0.05, "cooldown-floor": 0.25, "cap": null},
    "crit": {"multiplier": 2.0, "overflow": "crit chance above 1.0 adds to the multiplier (chance 1.5 → x2.5)"},
    "item-stat-curve": "stats.json#alpha-item-stat-formulas only (no 1.0 tier curve)",
    "prices": {"buy": "base[item-type] * item-level * rarity-mult (copper)", "sell": 0.25, "rarity-mult": {"common": 1, "uncommon": 2, "rare": 4, "epic": 8, "legendary": 16}, "base": {"weapon": 6, "armor": 6, "ring|amulet": 8, "consumable": 2, "material": 1, "formula": 10}, "calibration": "alpha sell range 20 copper (+1) … 1s50 (+100) for white gear"},
    "artifact": {"first": 0.05, "decay": 0.9, "floor": 0.01, "stats": "one traversal stat + attack + max-hp, all with this rule"},
    "stack-cap": null,
    "enemy-hp": {"rule": "stats.json#alpha-character-formulas.npc-hp * family-mult", "family-mult": "creature-families.json hp-mult, default 1.0", "calibration": "white mob at level 1 → 150–250 HP"},
    "circle-of-power": {"attack": 0.10, "max-hp": 0.10},
    "block-reward": "mp (D11: a successful block adds MP, the same bar special attacks spend)",
    "regeneration": "stamina (D11: the Regeneration stat only regens stamina; HP regen comes from food, potions, bedroll)",
    "artifacts-per-land": {"min": 1, "max": 3, "roll": "uniform, seeded, at land generation (D11)"},
    "pvp": {"slash-command": false, "server-cfg-flag": "pvp", "default": false, "note": "D11: no /pvp command; server-wide flag"},
    "recipes": {"weapon-cubes": "5 * size-class (dagger/fist/shield 1, one-handed 2, two-handed 4)", "gems-per-rarity-above-common": 1, "armor": "cotton table shape for every material"},
    "terrain": {"_doc": "D12 (2026-09-08): our world numbers; the sources never had them (alpha noise = x86 blob). Tune in play.", "block-m": 1.0, "zone-blocks": 64, "land-zones": 256, "land-blocks": 16384, "height": {"min": 0, "max": 255}, "sea-level": 96, "heightfield": {"base": 100, "amplitude": 56, "octaves": 5, "frequency": 0.004, "lacunarity": 2.0, "gain": 0.5}, "land-blend": "relief/base bilinear over the 4 nearest land centres, so borders have no cliffs", "cliff-slope": 1.2, "beach-above-sea": 2, "snow-above": 200, "water-color": "#2b64b4", "sand-color": "#d6c58a", "snow-color": "#e8eef5", "view-zones": 4, "seed-default": 26879},
    "climate": {"_doc": "D12: gen-climate numbers. Three seeded fields sampled once per land centre, normalised 0..1: temperature, humidity (fBm, frequency in lands), continent (oceans), relief (mountains). First matching rule wins; greenlands is the fallback.", "field-frequency-lands": 0.15, "field-octaves": 3, "rules": [["oceans", "continent < 0.3"], ["mountains", "relief > 0.78"], ["deadlands", "roll < 0.05"], ["snowlands", "temp < 0.25"], ["lava-lands", "temp > 0.92 and humidity < 0.35"], ["deserts", "temp > 0.7 and humidity < 0.3"], ["jungles", "temp > 0.7 and humidity > 0.65"], ["savannahs", "temp > 0.6 and humidity < 0.65"], ["wetlands", "humidity > 0.8"], ["dark-woods", "temp < 0.45 and humidity > 0.6"], ["greenlands", "true"]], "hud": {"temp-c": "lerp(-10, 40, temp)", "humidity-pct": "100 * humidity"}},
    "names": {"_doc": "D12: gen-name land rule. name = 2-3 syllables, capitalised, + suffix by landscape (generators.json#names.land shape).", "syllables": ["a", "ar", "ca", "co", "da", "du", "ga", "io", "ka", "la", "ma", "ni", "no", "ra", "ri", "sa", "tri", "va", "var", "on", "is", "ion", "mar", "lan", "san"], "land-suffix": {"greenlands": ["Plains", "Hills"], "snowlands": ["Mountains", "Hills"], "deserts": ["Plains", "Hills"], "jungles": ["Forest"], "lava-lands": ["Mountains"], "oceans": ["Islands"], "savannahs": ["Plains"], "wetlands": ["Plains"], "dark-woods": ["Forest"], "deadlands": ["Hills"], "mountains": ["Mountains"]}}
  },
  "network-alpha": {"port": 12345, "protocol": "TCP", "client-version": 3, "tick-hz": 50, "compression": "zlib", "authority": "client (anticheat scripts)", "packets-c2s": {"0": "EntityUpdate", "6": "Interact", "7": "Hit", "8": "Passive", "9": "Shoot", "10": "ChatMessage", "11": "ChunkDiscovered", "12": "SectorDiscovered", "17": "ClientVersion"}, "packets-s2c": {"0": "EntityUpdate", "1": "MultipleEntityUpdate", "2": "UpdateFinished", "3": "AirshipUpdate", "4": "ServerUpdate", "5": "CurrentTime", "10": "ServerChatMessage", "15": "SeedData", "16": "JoinPacket", "17": "ServerMismatch", "18": "ServerFull"}, "max-players": 4, "max-players-configurable": true, "hit-types": {"0": "normal", "1": "block", "3": "miss", "5": "absorb"}, "interact-types": {"2": "npc", "3": "normal", "5": "pickup", "6": "drop", "8": "examine"}, "anticheat-caps": {"level": 1000, "rarity": 4, "air-time-s": 10}}
}
