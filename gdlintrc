# ponytail: defer naming and size limits until a dedicated lint cleanup.
# gdformat enforces layout separately. Keep parse checks and suspicious-code rules.
disable:
  - max-line-length
  - max-file-lines
  - class-definitions-order
  - function-name
  - function-variable-name
  - function-argument-name
  - loop-variable-name
  - max-returns
  - max-public-methods
  - function-arguments-number
